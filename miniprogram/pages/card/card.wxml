<!-- 诗卡页 -->
<view class="card-page">
  <view class="back-btn" bind:tap="goBack">
    <icon-svg name="paper_back" size="36" stroke="0" />
  </view>
  <view class="loading" wx:if="{{!poem}}">加载中...</view>

  <!-- 隐藏 Canvas，2x 高清绘制卡片 -->
  <canvas type="2d" id="cardCanvas" class="card-canvas" style="width:{{canvasStyleW}}px;height:{{canvasStyleH}}px"></canvas>

  <block wx:if="{{poem}}">
    <view class="share-card">
      <view class="sc-pic" style="height:{{picH}}rpx">
        <image class="sc-bg" src="{{poemBg}}" mode="aspectFill" />
        <view class="sc-poem" style="height:{{poemH}}rpx">
          <view class="sc-scroll-bg"></view>
          <poem-vertical poem="{{poem}}" size="md" mode="light" />
        </view>
      </view>
      <view class="sc-info">
        <text class="sn">《{{poem.title}}》</text>
        <text class="sa">{{poem.dynasty}}·{{poem.author}}</text>
        <view class="sc-waves">
          <view wx:for="{{waveHeights}}" wx:key="*this" class="wbar" style="height:{{item}}rpx"></view>
        </view>
        <view class="sc-qr">
          <image wx:if="{{!qrFail}}" class="sc-qr-img" src="{{qrUrl}}" mode="aspectFit" binderror="onQrError" />
          <icon-svg wx:else name="paper_sprout_sm" size="52" stroke="0" />
          <text class="sc-qr-tip">扫码听诗</text>
        </view>
      </view>
      <view class="sc-foot">扫码听 · 诗芽 · 一诗一景</view>
    </view>

    <view class="share-acts">
      <view class="sa-btn" bind:tap="saveCard">
        <view class="sa-icon"><icon-svg name="paper_save" size="48" stroke="0" /></view>
        <text>保存</text>
      </view>
      <view class="sa-btn" bind:tap="shareCard">
        <view class="sa-icon"><icon-svg name="paper_share" size="48" stroke="0" /></view>
        <text>分享</text>
      </view>
      <view class="sa-btn" bind:tap="printCard">
        <view class="sa-icon"><icon-svg name="paper_print" size="48" stroke="0" /></view>
        <text>打印</text>
      </view>
    </view>
  </block>
</view>
