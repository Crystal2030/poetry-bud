<!-- 诗卡页 -->
<view class="card-page">
  <view class="back-btn" bind:tap="goBack"><text style="font-size:32rpx;color:#fff">‹</text></view>
  <view class="loading" wx:if="{{!poem}}">加载中...</view>

  <block wx:if="{{poem}}">
    <view class="share-card">
      <view class="sc-pic">
        <image class="sc-bg" src="{{poemBg}}" mode="aspectFill" />
        <view class="sc-poem">
          <poem-vertical poem="{{poem}}" size="md" mode="light" />
        </view>
      </view>
      <view class="sc-info">
        <text class="sn">《{{poem.title}}》</text>
        <text class="sa">{{poem.dynasty}}·{{poem.author}}</text>
        <view class="sc-waves">
          <view wx:for="{{waveHeights}}" wx:key="*this" class="wbar" style="height:{{item}}rpx"></view>
        </view>
        <view class="sc-qr">
          <text style="font-size:16rpx">扫码听诗</text>
        </view>
      </view>
      <view class="sc-foot">扫码听 · 诗芽 · 一诗一景</view>
    </view>

    <view class="share-acts">
      <view class="sa-btn" bind:tap="saveCard"><view class="cir">📥</view><text>保存</text></view>
      <view class="sa-btn" bind:tap="shareCard"><view class="cir">🔗</view><text>分享</text></view>
      <view class="sa-btn"><view class="cir">🖨</view><text>打印</text></view>
    </view>
  </block>
</view>
