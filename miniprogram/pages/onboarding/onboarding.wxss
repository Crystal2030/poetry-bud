.onboarding-container { height: 100vh; background: var(--paper); }
.onboarding-swiper { height: 100%; }
.onboard-slide { display:flex; flex-direction:column; align-items:center; justify-content:center; padding:60rpx 40rpx; height:100%; }

/* 屏1 */
.slide-1 { gap:20rpx; }
.sky-bg { position:absolute; top:0; left:0; right:0; height:50%; background:linear-gradient(180deg, #EDE0C8, #F4EBDA); }
.sprout-area { z-index:1; }
.sprout-big { width:160rpx; height:180rpx; }
.seal-title { display:inline-block; padding:12rpx 36rpx; background:var(--seal); border-radius:4rpx; transform:rotate(-2deg); margin:20rpx 0; }
.seal-text { color:#fff; font-size:40rpx; font-family:'STKaiti','KaiTi',serif; }
.slide-subtitle { font-size:30rpx; color:var(--ink); }
.slide-meta { font-size:24rpx; color:var(--ink-soft); }
.swipe-hint { font-size:22rpx; color:var(--ink-soft); margin-top:40rpx; animation: floatHint 1.5s ease-in-out infinite; }
@keyframes floatHint { 0%,100% { transform:translateX(0); } 50% { transform:translateX(10rpx); } }

/* 屏2 */
.slide-title { font-size:34rpx; font-weight:700; color:var(--ink); margin-bottom:30rpx; }
.slide-title-icon { width: 34rpx; height: 34rpx; margin-right: 8rpx; }
.age-cards { display:flex; flex-direction:column; gap:16rpx; width:100%; }
.age-card { display:flex; align-items:center; gap:20rpx; background:var(--paper-warm); border-radius:var(--radius-lg); padding:24rpx; box-shadow:0 2px 3px var(--shadow-lg); border:2px solid transparent; transition:all 0.3s; }
.age-card.selected { border-color:var(--gold); background:rgba(201,162,75,0.08); }
.age-icon { width:72rpx; height:72rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:36rpx; }
.age-icon-img { width:36rpx; height:36rpx; }
.preschool-icon { background:#E8F5E0; } .junior-icon { background:#E8EFF5; } .senior-icon { background:#F5EDE0; }
.age-name { font-size:32rpx; font-weight:700; color:var(--ink); display:block; }
.age-desc { font-size:24rpx; color:var(--ink-soft); display:block; margin-top:4rpx; }
.age-tag { font-size:20rpx; color:var(--seal); display:block; margin-top:6rpx; font-style:italic; }
.modify-hint { font-size:22rpx; color:var(--ink-soft); margin-top:20rpx; }

/* 屏3 */
.value-grid { display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:16rpx; width:100%; margin-bottom:30rpx; }
.value-item { display:flex; flex-direction:column; align-items:center; gap:8rpx; background:var(--paper-warm); padding:20rpx 10rpx; border-radius:var(--radius-md); box-shadow:0 2px 3px var(--shadow-sm); }
.value-icon { font-size:40rpx; }
.value-icon-img { width:40rpx; height:40rpx; }
.value-label { font-size:20rpx; color:var(--ink-soft); }
.trust-seal { display:inline-block; padding:12rpx 40rpx; background:var(--seal); border-radius:4rpx; transform:rotate(-1deg); margin-bottom:30rpx; }
.seal-text-sm { color:#fff; font-size:26rpx; font-family:'STKaiti','KaiTi',serif; }
.gold-btn { background:linear-gradient(135deg, var(--gold), var(--gold-deep)); color:#fff; border:none; border-radius:var(--radius-xl); padding:24rpx 0; font-size:30rpx; font-weight:600; width:100%; box-shadow:0 2px 6px var(--shadow-gold); }
.start-btn-icon { width: 30rpx; height: 30rpx; vertical-align: middle; margin-right: 6rpx; }
