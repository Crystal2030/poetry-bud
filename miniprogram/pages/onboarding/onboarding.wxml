<!-- 首次引导 3 屏 -->
<view class="onboarding-container">
  <swiper class="onboarding-swiper" indicator-dots="{{true}}" indicator-color="rgba(43,42,40,0.2)" indicator-active-color="#C0553F" bindchange="onSwiperChange" current="{{current}}">
    
    <!-- 屏1: 品牌初遇 -->
    <swiper-item>
      <view class="onboard-slide slide-1">
        <!-- 花瓣飘落容器（第一屏专属） -->
        <view class="petal-container">
          <view class="petal p1"></view>
          <view class="petal p2"></view>
          <view class="petal p3"></view>
          <view class="petal p4"></view>
          <view class="petal p5"></view>
          <view class="petal p6"></view>
          <view class="petal p7"></view>
          <view class="petal p8"></view>
        </view>
        <!-- 芽芽 SVG 弹跳动画 -->
        <view class="sprout-bounce-area">
          <image class="sprout-bounce-img" src="/static/icons/paper/sprout-large.svg" mode="aspectFit"/>
        </view>
        <view class="seal-title">
          <text class="seal-text">诗 芽</text>
        </view>
        <text class="slide-subtitle">每首古诗都是一个会动的小世界</text>
        <text class="slide-meta">3-12岁 · 精选{{curriculumCount}}首课标古诗</text>
        <text class="swipe-hint">→ 右滑继续</text>
      </view>
    </swiper-item>

    <!-- 屏2: 年龄选择 -->
    <swiper-item>
      <view class="onboard-slide slide-2">
        <image class="slide-title-icon" src="/static/icons/paper/sprout-small.svg" mode="aspectFit"/>
        <text class="slide-title">帮芽芽认识你</text>
        <view class="age-cards">
          <view class="age-card {{selectedAge==='3-6'?'selected':''}}" data-age="3-6" bindtap="selectAge">
            <image class="age-icon-img" src="/static/icons/paper/bamboo.svg" mode="aspectFit"/>
            <view class="age-info">
              <text class="age-name">3-6岁</text>
              <text class="age-desc">大字·大图·纯语音</text>
              <text class="age-tag">识字启蒙小阶段 · 慢慢来就好</text>
            </view>
          </view>
          <view class="age-card {{selectedAge==='7-10'?'selected':''}}" data-age="7-10" bindtap="selectAge">
            <image class="age-icon-img" src="/static/icons/paper/sprout-large.svg" mode="aspectFit"/>
            <view class="age-info">
              <text class="age-name">7-9岁</text>
              <text class="age-desc">拼音·识字·跟读</text>
              <text class="age-tag">独立阅读小阶段 · 按自己的节奏</text>
            </view>
          </view>
          <view class="age-card {{selectedAge==='10-12'?'selected':''}}" data-age="10-12" bindtap="selectAge">
            <image class="age-icon-img" src="/static/icons/paper/tree.svg" mode="aspectFit"/>
            <view class="age-info">
              <text class="age-name">10-12岁</text>
              <text class="age-desc">课标进度·默背·赏析</text>
              <text class="age-tag">深度学习小阶段 · 每步都算数</text>
            </view>
          </view>
        </view>
        <text class="modify-hint">可随时在「我的」中修改</text>
      </view>
    </swiper-item>

    <!-- 屏3: 价值主张 -->
    <swiper-item>
      <view class="onboard-slide slide-3">
        <image class="slide-title-icon" src="/static/icons/paper/flower.svg" mode="aspectFit"/>
        <text class="slide-title">芽芽每天陪你学一首诗</text>
        <view class="value-grid">
          <view class="value-item" wx:for="{{values}}" wx:key="icon">
            <image class="value-icon-img" src="{{item.icon}}" mode="aspectFit"/>
            <text class="value-label">{{item.label}}</text>
          </view>
        </view>
        <view class="trust-seal">
          <text class="seal-text-sm">不注册 · 不收费 · 无广告</text>
        </view>
        <button class="start-btn gold-btn" bindtap="startExplore"><image class="start-btn-icon" src="/static/icons/paper/sparkle.svg" mode="aspectFit"/>开 始 探 索</button>
      </view>
    </swiper-item>
  </swiper>
</view>
