<!-- 我的 -->
<view class="page">
  <view class="profile">
    <image class="avatar-wrap" src="/static/logo.png" mode="aspectFit" />
    <!-- <text class="name">小朋友</text> -->
    <view class="tagline"><text>诗芽在手，古诗不愁</text><icon-svg name="paper_sprout_sm" size="24" stroke="0" /></view>
  </view>

  <view class="stat-cards">
    <view class="stat-item">
      <text class="stat-num c-green">{{readCount}}</text>
      <text class="stat-label">已读</text>
    </view>
    <view class="stat-item">
      <text class="stat-num c-red">{{favCount}}</text>
      <text class="stat-label">收藏</text>
    </view>
    <view class="stat-item">
      <text class="stat-num c-gold">125</text>
      <text class="stat-label">诗库</text>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bind:tap="resetData">
      <view class="menu-label"><icon-svg name="trash" size="26" color="#C9BBA7" /><text>清除学习记录</text></view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="version">诗芽 PoetryBud v2.0 · 一诗一景 · 四步学习</view>

  <custom-tabbar current="{{3}}" />
</view>
