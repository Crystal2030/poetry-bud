.page { min-height: 100vh; padding-bottom: 140rpx; }
.profile { padding: 32rpx 36rpx 16rpx; text-align: center; }
.avatar-wrap { width: 120rpx; height: 120rpx; border-radius: 28rpx; margin: 0 auto 18rpx; box-shadow: 0 6rpx 20rpx rgba(199, 62, 58, 0.18); }
.tagline { display: flex; align-items: center; justify-content: center; gap: 6rpx; font-size: 24rpx; color: var(--ink-soft); margin-top: 8rpx; }

.stat-cards { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20rpx; margin: 0 32rpx 20rpx; }
.stat-item { background: #fff; border-radius: 24rpx; padding: 28rpx 20rpx; text-align: center; box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05); }
.stat-num { font-size: 40rpx; font-weight: 700; display: block; }
.stat-label { font-size: 22rpx; color: var(--ink-soft); margin-top: 4rpx; display: block; }
.c-green { color: var(--moss-deep); }
.c-red { color: var(--seal); }
.c-purple { color: var(--purple); }

/* ── 连续打卡 ── */
.streak-card {
  margin: 0 32rpx 20rpx; background: linear-gradient(135deg, #FFF8E1, #FFF3D6);
  border-radius: 24rpx; padding: 20rpx 28rpx;
  display: flex; align-items: center; gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(201,162,75,0.18);
}
.streak-fire { font-size: 40rpx; }
.streak-num { font-size: 48rpx; font-weight: 800; color: var(--seal); }
.streak-label { font-size: 24rpx; color: var(--ink-soft); }

/* ── 学习日历 ── */
.calendar-card {
  margin: 0 32rpx 20rpx; background: #fff;
  border-radius: 24rpx; padding: 20rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05);
}
.cal-header { text-align: center; margin-bottom: 12rpx; }
.cal-month { font-size: 28rpx; font-weight: 700; color: var(--ink); }
.cal-weekdays {
  display: grid; grid-template-columns: repeat(7, 1fr);
  text-align: center; font-size: 22rpx; color: var(--ink-soft);
  margin-bottom: 8rpx;
}
.cal-grid {
  display: grid; grid-template-columns: repeat(7, 1fr);
  text-align: center; gap: 4rpx;
}
.cal-day {
  height: 52rpx; display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; color: var(--ink-soft); border-radius: 10rpx;
  transition: all 0.2s ease;
}
.cal-day.checked {
  background: var(--moss-deep); color: #fff; font-weight: 600;
}
.cal-day.today {
  border: 2rpx solid var(--gold); border-radius: 10rpx;
}
.cal-day.today.checked { border-color: var(--moss); }
.cal-day.future { color: #D0CBBF; }

/* ── 本周简报 ── */
.weekly-card {
  margin: 0 32rpx 20rpx; background: rgba(83,74,183,0.06);
  border-radius: 24rpx; padding: 20rpx 24rpx;
  border: 1rpx solid rgba(83,74,183,0.12);
}
.weekly-title { font-size: 24rpx; font-weight: 600; color: var(--purple); margin-bottom: 12rpx; }
.weekly-row { display: flex; gap: 32rpx; }
.weekly-item { font-size: 22rpx; color: var(--ink-soft); }

/* 菜单 */
.menu { margin: 0 32rpx 32rpx; background: #fff; border-radius: 32rpx; overflow: hidden; box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.05); }
.menu-item { padding: 28rpx 32rpx; font-size: 28rpx; display: flex; justify-content: space-between; align-items: center; border-bottom: 2rpx solid #f0ede6; }
.menu-label { display: flex; align-items: center; gap: 10rpx; }
.arrow { color: #C9BBA7; font-size: 32rpx; }

.version { padding: 28rpx 32rpx; font-size: 22rpx; color: var(--ink-soft); text-align: center; }
