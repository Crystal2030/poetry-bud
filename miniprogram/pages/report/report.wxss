.report-page { min-height: 100vh; background: #E8E2D6; }
.report-scroll { height: 100vh; }

/* 头部 */
.report-head { padding: 24rpx 36rpx 16rpx; display: flex; justify-content: space-between; align-items: center; }
.rh-left { display: flex; align-items: center; gap: 10rpx; }
.rh-icon { font-size: 32rpx; }
.rh-icon-img { width: 32rpx; height: 32rpx; }
.rh-title { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.rh-week { font-size: 24rpx; color: var(--ink-soft); background: var(--paper-warm); padding: 6rpx 20rpx; border-radius: 24rpx; }

/* 2×2 概览卡片 */
.overview-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; padding: 16rpx 32rpx; }
.ov-card { display: flex; flex-direction: column; align-items: center; padding: 28rpx 20rpx; }
.ov-icon-img { width: 36rpx; height: 36rpx; margin-bottom: 8rpx; }
.ov-num { font-size: 44rpx; font-weight: 700; color: var(--seal); }
.ov-label { font-size: 22rpx; color: var(--ink-soft); margin-top: 4rpx; }

/* 区域标签 */
.section-label { display: flex; align-items: center; gap: 8rpx; padding: 24rpx 36rpx 16rpx; }
.sl-icon { font-size: 28rpx; }
.sl-icon-img { width: 28rpx; height: 28rpx; }
.sl-text { font-size: 26rpx; font-weight: 700; color: var(--ink); }
.sl-sub { font-size: 20rpx; color: var(--ink-soft); margin-left: auto; }

/* 雷达图 */
.radar-section { margin: 0 0 20rpx; }
.radar-container { display: flex; flex-direction: column; align-items: center; padding: 0 20rpx; }
.radar-canvas { width: 480rpx; height: 480rpx; }
.radar-legend { display: flex; gap: 32rpx; margin-top: -20rpx; }
.rl-item { display: flex; align-items: center; gap: 8rpx; }
.rl-dot { width: 20rpx; height: 20rpx; border-radius: 50%; }
.rl-text { font-size: 22rpx; color: var(--ink-soft); }

/* 趋势图 */
.trend-section { margin: 0 0 20rpx; }
.trend-container { display: flex; justify-content: center; padding: 0 20rpx; }
.trend-canvas { width: 600rpx; height: 300rpx; }

/* 芽芽寄语 */
.card { background: #fff; border-radius: var(--radius-lg); box-shadow: 0 2px 4px var(--shadow); }
.sprout-advice { margin: 20rpx 32rpx; padding: 28rpx; }
.sa-header { margin-bottom: 12rpx; }
.sa-sprout { font-size: 28rpx; font-weight: 600; color: var(--moss-deep); }
.sa-sprout-img { width: 28rpx; height: 28rpx; margin-right: 6rpx; }
.sa-message { font-size: 26rpx; color: var(--ink-soft); line-height: 1.7; }

/* 下一步建议 */
.next-steps { padding: 0 32rpx 40rpx; }
.ns-card { padding: 24rpx; margin-bottom: 16rpx; }
.nsc-header { display: flex; align-items: center; gap: 10rpx; margin-bottom: 10rpx; }
.nsc-icon { font-size: 28rpx; }
.nsc-icon-img { width: 28rpx; height: 28rpx; }
.nsc-title { font-size: 26rpx; font-weight: 600; color: var(--ink); }
.nsc-desc { font-size: 24rpx; color: var(--ink-soft); line-height: 1.6; }
.nsc-btn { margin-top: 16rpx; background: linear-gradient(135deg, var(--gold), var(--gold-deep)); color: #fff; border: none; border-radius: var(--radius-xl); padding: 16rpx 0; font-size: 24rpx; width: 100%; }
