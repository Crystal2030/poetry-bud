<!-- 诗库 -->
<view class="page">
  <view class="lib-head">
    <text class="title">诗库</text>
    <text class="count">{{poems.length}}首</text>
  </view>

  <!-- 搜索 -->
  <view class="search-bar">
    <icon-svg class="search-icon" name="paper_search" size="32" stroke="0" />
    <input value="{{searchQuery}}" focus="{{searchFocus}}" bindinput="onSearch" bindblur="onSearchBlur" class="search-input" placeholder="输入诗名、作者或朝代…" placeholder-style="color:#C9BBA7;font-size:26rpx" />
  </view>

  <!-- 维度切换 -->
  <view class="dim-pills">
    <view wx:for="{{dims}}" wx:key="key" class="dpill {{dim === item.key ? 'on' : ''}}" bind:tap="switchDim" data-key="{{item.key}}">{{item.label}}</view>
  </view>

  <!-- 分类筛选 -->
  <scroll-view class="filter-row" scroll-x>
    <view wx:for="{{items}}" wx:key="*this" class="ftab {{selected === item ? 'on' : ''}}" bind:tap="filter" data-val="{{item}}">{{item}}</view>
  </scroll-view>

  <!-- 诗卡网格 -->
  <view class="lib-grid">
    <view class="pcard" wx:for="{{filteredPoems}}" wx:key="id" bind:tap="goDetail" data-id="{{item.id}}">
      <image class="pc-bg" src="{{item._bg}}" mode="aspectFill" />
      <text class="pc-tag">{{item.theme || item.sceneName || '诗词'}}</text>
      <view class="pc-poem">
        <poem-vertical poem="{{item}}" size="sm" mode="light" />
      </view>
      <view class="pc-foot">
        <text class="nm">{{item.title}}</text>
        <text class="au">{{item.author}}·{{item.dynasty}}</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!filteredPoems.length}}">
    {{searchQuery ? '没有找到匹配的诗' : '没有找到诗'}}
  </view>

  <custom-tabbar current="{{1}}" />
</view>
