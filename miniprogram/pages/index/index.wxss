.page { min-height: 100vh; padding-bottom: 140rpx; }

.home-head { padding: 16rpx 36rpx 8rpx; display: flex; align-items: center; justify-content: space-between; }
.greet { font-size: 26rpx; color: var(--ink-soft); }
.greet .bold { color: var(--ink); font-size: 32rpx; display: block; margin-top: 4rpx; font-weight: 700; }
.avatar { width: 88rpx; height: 88rpx; border-radius: 50%; background: #fff; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08); }

.home-body { padding: 0 32rpx; }

/* 搜索栏 */
.search-bar {
  display: flex; align-items: center; gap: 16rpx;
  background: #fff; border-radius: 36rpx;
  padding: 18rpx 28rpx; margin: 20rpx 0 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.search-icon { width: 32rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.search-placeholder { flex: 1; font-size: 26rpx; color: var(--ink-soft); }
.search-hint {
  font-size: 22rpx; color: #fff;
  background: linear-gradient(135deg, var(--purple), var(--purple-light));
  padding: 8rpx 24rpx; border-radius: 22rpx;
  font-weight: 600;
}

/* ── 分龄选择器 ── */
.age-selector {
  display: flex; justify-content: center; gap: 16rpx; margin: 8rpx 0 20rpx;
}
.age-pill {
  display: flex; align-items: center; gap: 8rpx;
  padding: 10rpx 28rpx; border-radius: 32rpx;
  font-size: 24rpx; color: var(--ink-soft);
  background: rgba(255,255,255,0.9);
  border: 2rpx solid rgba(90,83,71,0.15);
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
  transition: all 0.3s ease;
}
.age-pill.active {
  background: var(--gold); color: #fff; font-weight: 700;
  border-color: var(--gold-deep);
  box-shadow: 0 4rpx 16rpx rgba(201,162,75,0.35);
}
.age-icon-img { width: 28rpx; height: 28rpx; }

/* ── 打卡印章 ── */
.checkin-stamp {
  position: absolute; top: 24rpx; right: 24rpx; z-index: 6;
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: rgba(255,255,255,0.85);
  border: 3rpx solid var(--seal);
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; font-weight: 700; color: var(--seal);
  transform: rotate(-8deg);
  box-shadow: 0 2rpx 8rpx rgba(192,85,63,0.2);
  transition: all 0.3s ease;
}
.checkin-stamp.done {
  background: var(--seal); color: #fff; border-color: var(--seal);
  transform: rotate(0deg);
  box-shadow: 0 4rpx 16rpx rgba(192,85,63,0.4);
}
.checkin-done { display: flex; align-items: center; justify-content: center; gap: 4rpx; }
.daily-bg {
  display: block;
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  width: 100%; height: 100%;
  z-index: 1;
  /* ── 关键：image 是原生组件，native hit-area 不严格遵守 z-index。
        若不禁掉，会截走整张 daily-card 的 tap，让打卡按钮 catch:tap 拿不到事件。 ── */
  pointer-events: none;
}
.daily-badge { position: absolute; top: 24rpx; left: 24rpx; z-index: 4; display: flex; align-items: center; gap: 8rpx; background: rgba(255,255,255,0.88); color: var(--seal); font-size: 22rpx; font-weight: 700; padding: 10rpx 22rpx; border-radius: 28rpx; }
.daily-badge text { display: inline-block; }
.daily-poem {
  position: absolute; top: 40rpx; right: 40rpx; z-index: 3;
  /* ── 古书卷轴衬底：半透明暖纸（以 background-color 确保兼容） ── */
  background-color: rgba(245,235,218,0.80);
  background-image: linear-gradient(180deg, rgba(247,240,228,0.80) 0%, rgba(242,234,216,0.85) 100%);
  border: 1rpx solid rgba(139,110,70,0.12);
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.16);
  padding: 12rpx 14rpx 14rpx;
}
.daily-foot { position: absolute; bottom: 0; left: 0; right: 0; z-index: 3; padding: 60rpx 32rpx 28rpx; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,0.55)); }
.daily-foot .nm { font-size: 30rpx; font-weight: 600; display: block; }
.daily-foot .sub { font-size: 22rpx; opacity: 0.88; margin-top: 6rpx; display: block; }

/* ── 每日一诗卡片 ── */
.daily-card {
  position: relative; overflow: hidden;
  height: 496rpx; border-radius: 40rpx;
  margin-bottom: 24rpx;
  /* ── 远程图加载失败时的暖色兜底，避免一片空白 ── */
  background: linear-gradient(135deg, #C9D9C0 0%, #B8C9A8 40%, #A8B894 100%);
  background-color: #B8C9A8;
}

.section-title { font-size: 28rpx; font-weight: 700; color: var(--ink); margin: 32rpx 8rpx 20rpx; }

.cat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-bottom: 24rpx; }
.cat { display: flex; flex-direction: column; justify-content: space-between; border-radius: 32rpx; padding: 32rpx 28rpx; color: #fff; height: 156rpx; position: relative; overflow: hidden; box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.12); }
.cat .n { font-size: 32rpx; font-weight: 700; position: relative; z-index: 1; }
.cat .d { font-size: 20rpx; opacity: 0.92; position: relative; z-index: 1; }
/* .cat .em 已移除：纸艺SVG背景替换了原有图标层 */
.cat-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0.85;
  pointer-events: none;
  border-radius: 32rpx;
}
.c1 { background: linear-gradient(135deg, #B5896B, #8A5F42); }
.c2 { background: linear-gradient(135deg, #7FA8C9, #5E86A8); }
.c3 { background: linear-gradient(135deg, #8FBF86, #6FA36A); }
.c4 { background: linear-gradient(135deg, #C9857F, #B0655E); }

.buddy-row { margin: 24rpx 0 60rpx;  background: #fff; border-radius: 32rpx; padding: 24rpx 28rpx; display: flex; align-items: center; gap: 24rpx; box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.06); }
.buddy-icon { width: 80rpx; height: 80rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.buddy-row .b2 { display: flex; align-items: center; gap: 4rpx; }
.buddy-row .txt .b1 { font-size: 26rpx; font-weight: 600; color: var(--ink); display: block; }
.buddy-row .txt .b2 { font-size: 22rpx; color: var(--ink-soft); margin-top: 4rpx; display: block; }

/* ── 通用图标尺寸 ── */
.icon-xs { width: 16rpx; height: 16rpx; }
.icon-sm { width: 28rpx; height: 28rpx; }
.icon-md { width: 36rpx; height: 36rpx; }
.icon-lg { width: 48rpx; height: 48rpx; }

/* ── 卷轴端头：左右金色小圆轴（首页版，略小） ── */
.daily-poem::before,
.daily-poem::after {
  content: '';
  position: absolute;
  top: 16rpx;
  bottom: 16rpx;
  width: 8rpx;
  background: linear-gradient(180deg, #C9A24B, #B8953A);
  border-radius: 4rpx;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.3);
}
.daily-poem::before { left: -4rpx; }
.daily-poem::after  { right: -4rpx; }

/* ── 花瓣飘落动画（撒花效果）── */
.petal-shower {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  z-index: 999; pointer-events: none; overflow: hidden;
}
.petal {
  position: absolute; top: -40rpx;
  width: 28rpx; height: 28rpx;
  border-radius: 42% 0 58% 12%;
  opacity: 0;
  will-change: transform, opacity;
  animation: petalFall linear infinite;
}
/* 金-粉-绿三色循环，纸艺剪纸风格 */
.petal.p1  { left: 5%;  background: rgba(232,192,99,0.9);   animation-duration: 8s;  animation-delay: 0s;   width: 24rpx; height: 24rpx; }
.petal.p2  { left: 15%; background: rgba(232,178,144,0.85); animation-duration: 9s;  animation-delay: 1s;   width: 20rpx; height: 20rpx; }
.petal.p3  { left: 25%; background: rgba(201,162,75,0.88);  animation-duration: 10s; animation-delay: 2s;   width: 26rpx; height: 26rpx; border-radius: 35% 5% 60% 15%; }
.petal.p4  { left: 35%; background: rgba(110,138,94,0.82);   animation-duration: 7.5s; animation-delay: 0.5s; width: 22rpx; height: 22rpx; }  /* --moss 芽绿 */
.petal.p5  { left: 45%; background: rgba(232,178,144,0.78);  animation-duration: 8.5s; animation-delay: 3s;   width: 28rpx; height: 28rpx; }
.petal.p6  { left: 55%; background: rgba(208,175,105,0.8);   animation-duration: 9.5s; animation-delay: 1.5s; width: 20rpx; height: 20rpx; }
.petal.p7  { left: 65%; background: rgba(89,121,73,0.84);    animation-duration: 8s;  animation-delay: 2.5s; width: 24rpx; height: 24rpx; border-radius: 50% 2% 48% 18%; }  /* --moss-deep 苔绿 */
.petal.p8  { left: 75%; background: rgba(201,162,75,0.83);   animation-duration: 10.5s;animation-delay: 0.8s; width: 22rpx; height: 22rpx; }
.petal.p9  { left: 85%; background: rgba(232,178,144,0.88);  animation-duration: 7.8s; animation-delay: 3.5s; width: 26rpx; height: 26rpx; }
.petal.p10 { left: 92%; background: rgba(110,138,94,0.78);   animation-duration: 9.2s; animation-delay: 4s;   width: 20rpx; height: 20rpx; border-radius: 30% 0 65% 10%; }  /* 芽绿变体 */

@keyframes petalFall {
  0% {
    transform: translateY(-40rpx) rotate(0deg) translateX(0);
    opacity: 0;
  }
  5% {
    opacity: 1;
  }
  50% {
    transform: translateY(50vh) rotate(180deg) translateX(40rpx);
    opacity: 0.9;
  }
  85% {
    opacity: 0.6;
  }
  100% {
    transform: translateY(105vh) rotate(360deg) translateX(-20rpx);
    opacity: 0;
  }
}
