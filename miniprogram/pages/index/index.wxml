<!-- 首页 -->
<view class="page">
  <!-- 撒花/花瓣飘落效果 -->
  <view class="petal-shower">
    <view class="petal p1"></view>
    <view class="petal p2"></view>
    <view class="petal p3"></view>
    <view class="petal p4"></view>
    <view class="petal p5"></view>
    <view class="petal p6"></view>
    <view class="petal p7"></view>
    <view class="petal p8"></view>
    <view class="petal p9"></view>
    <view class="petal p10"></view>
  </view>

  <view class="home-head">
    <view class="greet">
      <text>{{timeGreet}}，小朋友</text>
      <text class="bold">今天想读哪首诗？</text>
    </view>
    <image class="avatar" src="/static/logo.png" mode="aspectFit" />
  </view>

  <view class="home-body">
    <!-- P0-01/04 家长价值信息条 -->
    <view class="info-bar" wx:if="{{!hideInfoBar}}">
      <image class="icon-md" src="/static/icons/paper/graduate.svg" mode="aspectFit"/>
      <text class="info-text">对标《语文课程标准(2022)》· 125首必背篇目</text>
      <text class="info-link" bindtap="openFAQ">了解详情 →</text>
    </view>

    <!-- P1-09 芽芽每日推荐诗卡 -->
    <view class="daily-poem-card paper-card-v5" wx:if="{{dailyPoem}}">
      <view class="card-header">
        <view class="card-badge"><image class="icon-sm" src="/static/icons/paper/flower.svg" mode="aspectFit"/><text>芽芽推荐</text></view>
        <text class="card-age-badge">{{ageLabel}}</text>
      </view>
      <view class="poem-preview" bindtap="goDetail" data-id="{{dailyPoem.id}}">
        <text class="poem-title-text">{{dailyPoem.title}}</text>
        <text class="poem-meta">{{dailyPoem.dynasty}} · {{dailyPoem.author}}</text>
      </view>
      <view class="poem-tags">
        <text class="tag-sm" wx:for="{{dailyPoem.tags}}" wx:key="*this">{{item}}</text>
      </view>
      <button class="explore-btn gold-btn-sm" bindtap="goDetail" data-id="{{dailyPoem.id}}">开始探索 →</button>
    </view>

    <!-- 搜索栏 -->
    <view class="search-bar" bind:tap="goSearch">
      <icon-svg name="paper_search" size="32" stroke="0" />
      <text class="search-placeholder">搜索诗人、诗名、诗句…</text>
      <text class="search-hint" catch:tap="goSearch">搜诗</text>
    </view>

    <!-- 分龄选择器 -->
    <view class="age-selector">
      <view class="age-pill {{ageBand === '3-6' ? 'active' : ''}}" bind:tap="switchAge" data-age="3-6">
        <image class="age-icon-img" src="/static/icons/paper/sprout-small.svg" mode="aspectFit"/>
        <text class="age-label">3-6岁</text>
      </view>
      <view class="age-pill {{ageBand === '7-10' ? 'active' : ''}}" bind:tap="switchAge" data-age="7-10">
        <image class="age-icon-img" src="/static/icons/paper/sprout-large.svg" mode="aspectFit"/>
        <text class="age-label">7-10岁</text>
      </view>
      <view class="age-pill {{ageBand === '10-12' ? 'active' : ''}}" bind:tap="switchAge" data-age="10-12">
        <image class="age-icon-img" src="/static/icons/paper/tree.svg" mode="aspectFit"/>
        <text class="age-label">10-12岁</text>
      </view>
    </view>

    <!-- 每日一诗 -->
    <view class="daily-card" wx:if="{{daily}}" bind:tap="goDetail" data-id="{{daily.id}}">
      <image class="daily-bg" src="{{dailyBg}}" mode="aspectFill" binderror="onDailyBgError" bindload="onDailyBgLoad" />
      <view class="daily-badge"><icon-svg name="sparkle" size="24" color="#C73E3A" stroke="1.8" /><text>每日一诗</text></view>
      <!-- 打卡印章 -->
      <view class="checkin-stamp {{checkedIn ? 'done' : ''}}" catch:tap="doCheckin">
        <text wx:if="{{!checkedIn}}">打卡</text>
        <view wx:else class="checkin-done">
          <image class="icon-xs" src="/static/icons/paper/check.svg" mode="aspectFit"/>
          <text>已打卡</text>
        </view>
      </view>
      <view class="daily-poem">
        <poem-vertical poem="{{daily}}" size="sm" mode="{{sceneMode}}" />
      </view>
      <view class="daily-foot">
        <text class="nm">《{{daily.title}}》· {{daily.author}}</text>
        <text class="sub">{{daily.funTip || '点击走进诗中世界'}}</text>
      </view>
    </view>

    <!-- 四维探索 -->
    <view class="section-title">四维探索</view>
    <view class="cat-grid">
      <view class="cat c1" bind:tap="goLibrary" data-dim="dynasty">
        <image class="cat-bg" src="/static/images/dim-dynasty.svg" mode="aspectFill" />
        <text class="n">朝代</text><text class="d">穿越千年时光</text>
      </view>
      <view class="cat c2" bind:tap="goLibrary" data-dim="author">
        <image class="cat-bg" src="/static/images/dim-author.svg" mode="aspectFill" />
        <text class="n">作者</text><text class="d">和诗人交朋友</text>
      </view>
      <view class="cat c3" bind:tap="goLibrary" data-dim="grade">
        <image class="cat-bg" src="/static/images/dim-grade.svg" mode="aspectFill" />
        <text class="n">年级</text><text class="d">课标进度书架</text>
      </view>
      <view class="cat c4" bind:tap="goLibrary" data-dim="theme">
        <image class="cat-bg" src="/static/images/dim-theme.svg" mode="aspectFill" />
        <text class="n">主题</text><text class="d">山水·思乡·咏物</text>
      </view>
    </view>

    <!-- 芽芽 -->
    <view class="buddy-row">
      <view class="buddy-icon"><icon-svg name="paper_sprout_sm" size="80" stroke="0" /></view>
      <view class="txt">
        <text class="b1">芽芽：你已经读了 {{readCount}} 首诗啦！</text>
        <text class="b2" bind:tap="goGarden">诗径花园里又开了一朵花 去看看<icon-svg name="chevron-right" size="22" color="#534AB7" stroke="2" /></text>
      </view>
    </view>
  </view>

  <custom-tabbar current="{{0}}" />
</view>
