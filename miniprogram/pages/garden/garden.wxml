<!-- 花园 v6.0：对齐 UI 稿（主景卡片 + 进度条 + 3D 阶梯 + 成长徽章大勋章） -->
<view class="garden-page">

  <!-- 主景卡片：花园背景 + 当前阶段植物 + 能量粒子 -->
  <view class="garden-card">
    <image class="gc-bg" src="/static/garden/garden-bg-empty.jpg" mode="aspectFill"/>
    <view class="gc-stage-wrap">
      <image class="gc-stage-img" src="{{stageAsset}}" mode="aspectFit"/>
    </view>
    <!-- 能量粒子 -->
    <view class="energy-dot" wx:for="{{energyDots}}" wx:key="id"
          style="top:{{item.top}}rpx;left:{{item.left}}rpx;animation-delay:{{item.delay}}s"></view>
    <!-- 顶部浮层：标题 + 数据 + 分享 -->
    <view class="garden-hud">
      <view class="hud-title">
        <image class="hud-icon" src="/static/icons/paper/flower.svg" mode="aspectFit"/>
      </view>
      <view class="hud-right">
        <view class="hud-stats">
          <text class="hud-item">种活 <text class="hud-num">{{flowerCount}}</text> 朵</text>
          <text class="hud-sep">·</text>
          <text class="hud-item">连续 <text class="hud-num">{{streakDays}}</text> 天</text>
        </view>
        <button class="garden-share" open-type="share" hover-class="garden-share-tap" aria-label="分享花园">
          <icon-svg name="paper_share" size="30" stroke="0" />
        </button>
      </view>
    </view>
  </view>

  <!-- 棕色区域（顶部弧形衔接） -->
  <view class="garden-brown">
    <!-- 进度条 -->
    <view class="gc-progress">
      <view class="gc-progress-bar">
        <view class="gc-progress-fill" style="width:{{progressPct}}%"></view>
      </view>
      <view class="gc-progress-label" wx:if="{{!isMax}}">再读 <text class="gc-num">{{remain}}</text> 首 → {{nextStageName}}</view>
      <view class="gc-progress-label" wx:else>你已来到满园诗径</view>
    </view>

    <!-- 我的纸花园 · 3D 阶梯 -->
    <view class="section">
      <view class="sec-head"><view class="light"></view><text class="sec-title">我的纸花园</text></view>
      <view class="stairs-3d">
        <view class="s3d {{item.on ? 'on' : ''}}" wx:for="{{stairs}}" wx:key="key"
              style="left:{{item.left}}rpx;height:{{item.h}}rpx">
          <view class="front">{{item.num}}</view>
        </view>
        <view class="stairs-glow" style="left:{{glowLeft}}rpx;top:{{glowTop}}rpx">
          <view class="particle" wx:for="{{particles}}" wx:key="id"
                style="left:{{item.left}};top:{{item.top}};--dx:{{item.dx}}rpx;--dy:{{item.dy}}rpx;animation-delay:{{item.delay}}s"></view>
        </view>
      </view>
    </view>

    <!-- 成长徽章 -->
    <view class="section">
      <view class="sec-head"><view class="light"></view><text class="sec-title">成长徽章</text></view>
      <view class="badge-wrap">
        <!-- 顶部大勋章：单张完整勋章图铺底 + 中央叠当前勋章（0 朵无任何徽章解锁时整体隐藏） -->
        <view class="badge-hero" wx:if="{{latestBadge}}">
          <view class="medal-stage">
            <image class="medal-bg" src="/static/garden/big-medal-full.png" mode="aspectFit" lazy-load="{{true}}"/>
            <view class="medal-center" wx:if="{{latestBadge}}">
              <image class="medal-center-img" src="{{latestBadge.icon}}" mode="aspectFill" lazy-load="{{true}}"/>
            </view>
          </view>
          <view class="badge-hero-info" wx:if="{{latestBadge}}">最新解锁 · {{latestBadge.name}}</view>
        </view>
        <!-- 6 枚小徽章（3 列网格，已解锁=勋章图，未解锁=锁） -->
        <view class="badge-grid">
          <view class="badge-cell {{item.earned ? 'earned' : 'lock'}}" wx:for="{{badges}}" wx:key="key">
            <view class="ring">
              <image wx:if="{{item.earned}}" class="ring-img" src="{{item.icon}}" mode="aspectFill" lazy-load="{{true}}"/>
              <image wx:else class="ring-lock" src="/static/icons/paper/badge-lock.svg" mode="aspectFit" lazy-load="{{true}}"/>
            </view>
            <view class="label">{{item.name}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <custom-tabbar current="{{2}}" />
</view>
