<!-- 花园 v3.0 -->
<view class="garden-page">
<!-- 天空背景（4态：晨/昼/暮/夜；v5 增强：月相+季节彩蛋+流星+云视差） -->
<view class="sky-canvas {{skyPhase}}">
  <view class="sun-moon">
    <!-- 仅夜间显示月相阴影 -->
    <view class="moon-mask phase-{{moonPhase}}" wx:if="{{skyPhase === 'night'}}"></view>
  </view>
  <view class="cloud-layer">
    <view class="cloud c1"></view><view class="cloud c2"></view><view class="cloud c3"></view>
    <view class="cloud c4"></view><view class="cloud c5"></view>
  </view>
  <view class="star-layer" wx:if="{{skyPhase === 'night'}}">
    <view class="star" wx:for="{{6}}" wx:key="*this" style="left:{{item*14+5}}%;top:{{item*8+10}}%"></view>
  </view>
  <!-- 流星（仅夜间） -->
  <view class="meteor-layer" wx:if="{{skyPhase === 'night'}}">
    <view class="meteor m1"></view>
    <view class="meteor m2"></view>
    <view class="meteor m3"></view>
  </view>
  <!-- 季节彩蛋（一直显示，spring=花瓣/summer=萤火/autumn=红叶/winter=雪花） -->
  <view class="season-layer {{seasonName}}">
    <view class="season-particle p1"></view>
    <view class="season-particle p2"></view>
    <view class="season-particle p3"></view>
    <view class="season-particle p4"></view>
    <view class="season-particle p5"></view>
  </view>
  <text class="sky-tag {{seasonName}}">{{seasonLabel}} · {{skyPhase === 'night' ? moonPhaseName : (skyPhase === 'morning' ? '日出' : skyPhase === 'noon' ? '晴午' : '黄昏')}}</text>
</view>

  <!-- 顶部信息栏 -->
  <view class="garden-head">
    <view class="head-title">
      <image class="head-icon-img" src="/static/icons/paper/flower.svg" mode="aspectFit"/>
      <text class="head-text">诗径花园</text>
    </view>
    <view class="head-stats">
      <text class="hs-item">种活<text class="hs-num">{{flowerCount}}</text>朵</text>
      <text class="hs-divider">|</text>
      <text class="hs-item">连续<text class="hs-num">{{streakDays}}</text>天</text>
    </view>
  </view>

  <scroll-view class="garden-scroll" scroll-y enhanced show-scrollbar="{{false}}">

    <!-- 中心生长树（5阶段：seed/sprout/sapling/flowering/bloom） -->
    <view class="growth-tree-area">
      <view class="tree-stage stage-{{treeStage}}">
        <image class="tree-image" src="/static/icons/tree-{{treeStage}}.svg" mode="aspectFit"/>
      </view>
      <view class="tree-label">
        <text class="tree-name">{{treeStageName}}</text>
        <text class="tree-hint">再读<text class="tree-num">{{poemsToNextStage}}</text>首 → {{nextStageName}}</text>
      </view>
    </view>

    <!-- v5 阶梯花园：每升一阶花园长大一圈；当前阶段高亮+中央大插画+阶梯条 -->
    <view class="staircase-garden">
      <view class="section-label">
        <image class="sl-icon-img" src="/static/icons/paper/bouquet.svg" mode="aspectFit"/>
        <text class="sl-text">我的纸花园</text>
        <view class="sl-tag">{{gardenStageName}}</view>
      </view>

      <!-- 中央插画（当前阶段形象） -->
      <view class="sg-stage-stage">
        <image class="sg-stage-img" src="{{gardenStageAsset}}" mode="aspectFit"/>
        <view class="sg-stage-shadow"></view>
      </view>

      <!-- 阶梯条：6 段，左低右高，当前段隆起 -->
      <view class="sg-track">
        <view wx:for="{{gardenStages}}" wx:for-index="gi" wx:key="key"
              class="sg-step {{item.threshold <= gardenStages[gardenStageIdx].threshold ? 'achieved' : ''}} {{item.key === gardenStage ? 'current' : ''}}"
              style="height:{{80 + gi*18}}rpx">
          <text class="sg-step-num">{{item.threshold}}</text>
          <text class="sg-step-name">{{item.name}}</text>
        </view>
      </view>

      <!-- 进度提示 -->
      <view class="sg-hint" wx:if="{{nextGardenStageName !== '已是满园诗径'}}">
        再读<text class="sg-hint-num">{{poemsToNextStageNum}}</text>首 → {{nextGardenStageName}}
      </view>
      <view class="sg-hint done" wx:else>
        你已来到满园诗径 🌸
      </view>
    </view>

    <!-- 旅程时间线（水平滚动） -->
    <view class="timeline-section">
      <view class="section-label">
        <image class="sl-icon-img" src="/static/icons/paper/scroll.svg" mode="aspectFit"/>
        <text class="sl-text">成长旅程</text>
      </view>
      <scroll-view class="timeline-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="timeline-track">
          <view class="tl-dot {{item.achieved ? 'done' : ''}} {{item.current ? 'current' : ''}}" wx:for="{{milestones}}" wx:key="id">
            <image class="tl-icon-img" src="{{item.icon}}" mode="aspectFit"/>
            <text class="tl-date">{{item.date}}</text>
            <text class="tl-text">{{item.text}}</text>
          </view>
          <view class="tl-line"></view>
        </view>
      </scroll-view>
    </view>

    <!-- v4 成长徽章：最新解锁大卡（仪式感）+ 6 枚徽章横滑卡片 -->
    <view class="section-label">
      <image class="sl-icon-img" src="/static/icons/paper/trophy.svg" mode="aspectFit"/>
      <text class="sl-text">成长徽章</text>
    </view>
    <!-- 最新解锁大卡：每次进入花园都展示 -->
    <view class="badge-hero" wx:if="{{latestBadge}}">
      <view class="badge-hero-ring"></view>
      <view class="badge-hero-tag">最新解锁</view>
      <image class="badge-hero-img" src="{{latestBadge.icon}}" mode="aspectFit"/>
      <view class="badge-hero-info">
        <text class="badge-hero-name">{{latestBadge.name}}</text>
        <text class="badge-hero-desc">{{latestBadge.desc}}</text>
      </view>
    </view>
    <!-- 6 枚徽章横滑卡片（已解锁=金边，未解锁=灰底） -->
    <scroll-view class="badge-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="badge-track">
        <view wx:for="{{badges}}" wx:key="name" class="badge-cell {{item.earned ? 'earned' : 'locked'}} {{item.isLatest ? 'latest' : ''}}">
          <image class="badge-icon-img" src="{{item.icon}}" mode="aspectFit"/>
          <text class="badge-name">{{item.name}}</text>
          <text class="badge-desc">{{item.desc}}</text>
        </view>
      </view>
    </scroll-view>

    <view style="height:200rpx"></view>
  </scroll-view>

  <custom-tabbar current="{{2}}" />
</view>
