<!-- 花园 -->
<view class="page">
  <view class="garden-head">
    <text class="title">🌳 诗径花园</text>
    <text class="count">已学 {{readCount}} 首</text>
  </view>

  <view class="garden-section">
    <text class="tree">🌳</text>
    <text class="progress-num">{{progress}}%</text>
    <text class="progress-label">已读 {{readCount}}/{{total}} 首</text>
    <view class="garden-bar">
      <view class="garden-bar-fill" style="width:{{progress}}%"></view>
    </view>
    <view class="stats">
      <text>❤️ 收藏 {{favCount}}</text>
      <text>📖 总诗库 {{total}}</text>
      <text>🌟 级别 {{level}}</text>
    </view>
  </view>

  <view class="section-title">🎖 成长徽章</view>
  <view class="badge-grid">
    <view wx:for="{{badges}}" wx:key="name" class="badge-cell {{item.earned ? 'earned' : ''}}">
      <text class="badge-icon">{{item.earned ? item.icon : '🔒'}}</text>
      <text class="badge-name">{{item.name}}</text>
      <text class="badge-desc">{{item.desc}}</text>
    </view>
  </view>
</view>
