.page { min-height: 100vh; padding-bottom: 140rpx; }
.garden-head { padding: 16rpx 36rpx 8rpx; display: flex; justify-content: space-between; align-items: center; }
.title-row { display: flex; align-items: center; gap: 10rpx; font-size: 34rpx; font-weight: 700; }
.garden-head .count { font-size: 26rpx; color: var(--ink-soft); }

.garden-section { background: #fff; border-radius: 40rpx; padding: 48rpx; text-align: center; margin: 32rpx; box-shadow: 0 4rpx 6rpx var(--shadow), 0 8rpx 28rpx rgba(0,0,0,0.06); }
.tree-icon { display: flex; justify-content: center; margin-bottom: 16rpx; }
.progress-num { font-size: 60rpx; font-weight: 700; color: var(--moss-deep); }
.progress-label { font-size: 26rpx; color: var(--ink-soft); margin-top: 8rpx; display: block; }
.garden-bar { height: 20rpx; background: #E7DECB; border-radius: 10rpx; overflow: hidden; margin: 24rpx 0; }
.garden-bar-fill { height: 100%; background: linear-gradient(90deg, #8FBF86, #6FA36A); border-radius: 10rpx; }
.stats { display: flex; justify-content: space-around; margin-top: 32rpx; }
.stat-row { display: flex; align-items: center; gap: 6rpx; font-size: 24rpx; color: var(--ink-soft); }

.section-title { display: flex; align-items: center; gap: 8rpx; font-size: 28rpx; font-weight: 700; color: var(--ink); margin: 32rpx 36rpx 20rpx; }

/* ═══ 花园 v3.0 新增样式 ═══ */
.garden-page { min-height: 100vh; padding-bottom: 140rpx; }
.garden-scroll { height: calc(100vh - 100rpx); }

/* 天空背景 */
.sky-canvas { position: relative; height: 320rpx; overflow: hidden; transition: background 2s; }
.sky-canvas.morning { background: linear-gradient(180deg, #FDE8C8, #F4EBDA); }
.sky-canvas.noon   { background: linear-gradient(180deg, #C8E6F5, #F4EBDA); }
.sky-canvas.evening{ background: linear-gradient(180deg, #F5C8A0, #F4EBDA); }
.sky-canvas.night  { background: linear-gradient(180deg, #1A1A2E, #3D3D5C); }

.sun-moon { position: absolute; width: 80rpx; height: 80rpx; border-radius: 50%; top: 40rpx; right: 80rpx; }
.morning .sun-moon { background: #FFD700; box-shadow: 0 0 60rpx rgba(255,215,0,0.4); }
.noon .sun-moon   { background: #FFE44D; box-shadow: 0 0 80rpx rgba(255,228,77,0.5); }
.evening .sun-moon{ background: #FF8C42; box-shadow: 0 0 60rpx rgba(255,140,66,0.4); }
.night .sun-moon  { background: #F5F5DC; box-shadow: 0 0 40rpx rgba(245,245,220,0.3); }

.cloud { position: absolute; background: rgba(255,255,255,0.6); border-radius: 50rpx; }
.cloud.c1 { width:120rpx; height:50rpx; top:60rpx; left:10%; animation: cloudDrift 20s linear infinite; }
.cloud.c2 { width:160rpx; height:60rpx; top:100rpx; left:50%; animation: cloudDrift 25s linear infinite 5s; }
.cloud.c3 { width:100rpx; height:45rpx; top:30rpx; left:70%; animation: cloudDrift 18s linear infinite 10s; }
@keyframes cloudDrift { 0% { transform: translateX(0); } 100% { transform: translateX(80rpx); } }

.star { position: absolute; width: 6rpx; height: 6rpx; background: #fff; border-radius: 50%; opacity: 0.6; animation: twinkle 2s ease-in-out infinite; }
@keyframes twinkle { 0%,100% { opacity: 0.3; } 50% { opacity: 0.9; } }

/* 顶部信息栏 */
.garden-head { padding: 24rpx 36rpx; display: flex; justify-content: space-between; align-items: center; position: relative; z-index: 2; }
.head-title { display: flex; align-items: center; gap: 10rpx; }
.head-icon { font-size: 32rpx; }
.head-icon-img { width: 32rpx; height: 32rpx; }
.head-text { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.head-stats { display: flex; align-items: center; gap: 12rpx; font-size: 24rpx; color: var(--ink-soft); }
.hs-num { color: var(--seal); font-weight: 700; font-size: 28rpx; margin: 0 2rpx; }
.hs-divider { color: rgba(0,0,0,0.15); }

/* 生长树 */
.growth-tree-area { display: flex; flex-direction: column; align-items: center; padding: 40rpx 0 20rpx; position: relative; z-index: 1; margin-top: -20rpx; }
.tree-stage { width: 240rpx; height: 280rpx; display: flex; align-items: center; justify-content: center; }
.tree-image { width: 200rpx; height: 240rpx; }
.tree-label { text-align: center; margin-top: 8rpx; }
.tree-name { font-size: 30rpx; font-weight: 700; color: var(--moss-deep); display: block; }
.tree-hint { font-size: 22rpx; color: var(--ink-soft); margin-top: 6rpx; display: block; }
.tree-num { color: var(--seal); font-weight: 600; }

/* 纸花网格 */
.flower-grid-section { margin: 20rpx 32rpx; }
.section-label { display: flex; align-items: center; gap: 8rpx; margin-bottom: 16rpx; }
.sl-icon { font-size: 28rpx; }
.sl-icon-img { width: 28rpx; height: 28rpx; }
.sl-text { font-size: 26rpx; font-weight: 700; color: var(--ink); }
.flower-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12rpx; }
.flower-cell { display: flex; flex-direction: column; align-items: center; padding: 12rpx 6rpx; border-radius: var(--radius-md); background: rgba(255,255,255,0.5); }
.flower-cell.bloomed { background: rgba(201,162,75,0.1); }
.flower-icon-img { width: 36rpx; height: 36rpx; }
.flower-name { font-size: 18rpx; color: var(--ink-soft); margin-top: 4rpx; }

/* 旅程时间线 */
.timeline-section { margin: 20rpx 0; }
.timeline-scroll { width: 100%; white-space: nowrap; padding: 0 32rpx; }
.timeline-track { display: inline-flex; align-items: flex-start; gap: 32rpx; padding: 20rpx 0; position: relative; }
.tl-line { position: absolute; top: 32rpx; left: 0; right: 0; height: 3rpx; background: rgba(0,0,0,0.1); z-index: 0; }
.tl-dot { display: flex; flex-direction: column; align-items: center; gap: 4rpx; z-index: 1; min-width: 100rpx; opacity: 0.5; }
.tl-dot.done { opacity: 1; }
.tl-icon-img { width: 32rpx; height: 32rpx; }
.tl-date { font-size: 20rpx; color: var(--ink-soft); }
.tl-text { font-size: 18rpx; color: var(--ink); text-align: center; white-space: normal; max-width: 120rpx; }

/* ═══ v4 时间线：当前节点高亮 + 图标加大（节点肉眼可见「长大」） ═══ */
.tl-dot { transition: all .3s; }
.tl-icon-img { width: 56rpx; height: 56rpx; }
.tl-text { font-size: 22rpx; font-weight: 500; color: var(--ink); }
.tl-date { font-size: 18rpx; }
.tl-dot.current { transform: scale(1.18); }
.tl-dot.current .tl-icon-img { width: 76rpx; height: 76rpx; }
.tl-dot.current .tl-text { color: #993C1D; font-weight: 600; }
.tl-dot.done { color: var(--moss-deep); }

/* ═══ v4 徽章：最新解锁大卡（仪式感）+ 横滑卡片 ═══ */
.badge-hero {
  position: relative;
  margin: 0 32rpx 28rpx;
  padding: 32rpx 28rpx;
  background: #fff;
  border: 2rpx solid #D85A30;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  gap: 24rpx;
  overflow: hidden;
}
.badge-hero-ring {
  position: absolute;
  top: -40rpx; right: -40rpx;
  width: 220rpx; height: 220rpx;
  border-radius: 50%;
  border: 2rpx dashed #D85A30;
  opacity: .35;
}
.badge-hero-tag {
  position: absolute;
  top: 16rpx; right: 16rpx;
  font-size: 20rpx;
  color: #993C1D;
  background: #FAECE7;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.badge-hero-img { width: 132rpx; height: 132rpx; flex-shrink: 0; }
.badge-hero-info { flex: 1; min-width: 0; }
.badge-hero-name { font-size: 32rpx; font-weight: 600; color: var(--moss-deep); display: block; }
.badge-hero-desc { font-size: 24rpx; color: var(--ink-soft); margin-top: 8rpx; display: block; }

.badge-scroll { width: 100%; white-space: nowrap; padding: 0 32rpx 40rpx; }
.badge-track { display: inline-flex; gap: 16rpx; }
.badge-cell {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 200rpx;
  padding: 20rpx 12rpx;
  border-radius: var(--radius-lg);
  background: var(--paper-warm);
  transition: all .3s;
  white-space: normal;
}
.badge-cell.earned { background: #fff; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06); }
.badge-cell.latest { box-shadow: 0 0 0 2rpx #D85A30, 0 4rpx 12rpx rgba(216,90,48,.25); }
.badge-cell.locked { opacity: .35; filter: grayscale(.7); }
.badge-icon-img { width: 72rpx; height: 72rpx; display: block; margin-bottom: 10rpx; }
.badge-name { font-size: 26rpx; font-weight: 600; color: var(--ink); display: block; }
.badge-cell.locked .badge-name { color: var(--ink-soft); }
.badge-desc { font-size: 20rpx; color: var(--ink-soft); margin-top: 4rpx; display: block; line-height: 1.3; }

/* ═════════════════════════════════════════════════════════════
 * v5 天空增强：月相掩膜 + 流星 + 季节彩蛋 + 远近视差云层
 * ═════════════════════════════════════════════════════════════ */
.cloud.c4 { width: 220rpx; height: 60rpx; top: 80rpx; left: 25%; opacity: .35; animation: cloudDriftFar 120s linear infinite; }
.cloud.c5 { width: 70rpx;  height: 26rpx; top: 30rpx; left: 65%; opacity: .85; animation: cloudDriftNear 22s linear infinite 4s; }
@keyframes cloudDriftFar  { 0% { transform: translateX(0); } 100% { transform: translateX(360rpx); } }
@keyframes cloudDriftNear { 0% { transform: translateX(0); } 100% { transform: translateX(50rpx); } }

/* 月相：用同色阴影遮住月亮一部分（8 相位） */
.sun-moon { overflow: hidden; }
.moon-mask { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: #1A1A2E; border-radius: 50%; pointer-events: none; }
.moon-mask.phase-0 { transform: translateX(-100%); }      /* 新月：整圆遮 */
.moon-mask.phase-1 { transform: translateX(-30%); }      /* 蛾眉月：右半遮多一点 */
.moon-mask.phase-2 { transform: translateX(0%); }        /* 上弦月：右半遮住 */
.moon-mask.phase-3 { transform: translateX(30%); }       /* 盈凸月：略遮右下 */
.moon-mask.phase-4 { transform: translateX(100%); }      /* 满月：彻底露出 */
.moon-mask.phase-5 { transform: translateX(70%); }       /* 亏凸月：左下遮 */
.moon-mask.phase-6 { transform: translateX(50%); }       /* 下弦月：左半遮 */
.moon-mask.phase-7 { transform: translateX(35%); }       /* 残月：右下一线 */

/* 流星 */
.meteor-layer { position: absolute; inset: 0; pointer-events: none; }
.meteor { position: absolute; width: 4rpx; height: 100rpx; background: linear-gradient(180deg, transparent, #fff); border-radius: 4rpx; opacity: 0; transform: rotate(20deg); box-shadow: 0 0 12rpx rgba(255,255,255,.6); }
.meteor.m1 { top: 8%;  left: 75%; animation: meteorFlash 6s linear infinite; }
.meteor.m2 { top: 22%; left: 50%; animation: meteorFlash 8s linear infinite 2s; }
.meteor.m3 { top: 4%;  left: 88%; animation: meteorFlash 10s linear infinite 5s; }
@keyframes meteorFlash {
  0% { opacity: 0; transform: rotate(20deg) translate(0,0); }
  6% { opacity: 1; }
  18% { opacity: 0; transform: rotate(20deg) translate(-220rpx, 80rpx); }
  100% { opacity: 0; transform: rotate(20deg) translate(-220rpx, 80rpx); }
}

/* 季节彩蛋（4 态切换） */
.season-layer { position: absolute; inset: 0; pointer-events: none; }
.season-particle { position: absolute; will-change: transform; }

/* 春 · 樱花瓣 */
.spring .season-particle { width: 14rpx; height: 14rpx; background: #FFB7C5; border-radius: 70% 30% 70% 30%; }
.spring .season-particle.p1 { top: -20rpx; left: 15%; animation: petalFall 9s linear infinite; }
.spring .season-particle.p2 { top: -30rpx; left: 45%; animation: petalFall 12s linear infinite 2s; }
.spring .season-particle.p3 { top: -25rpx; left: 72%; animation: petalFall 10s linear infinite 4s; }
.spring .season-particle.p4 { top: -20rpx; left: 30%; animation: petalFall 11s linear infinite 1s; }
.spring .season-particle.p5 { top: -30rpx; left: 58%; animation: petalFall 8s linear infinite 5s; }
@keyframes petalFall {
  0%   { transform: translateY(0) translateX(0) rotate(0deg); opacity: 0; }
  10%  { opacity: .9; }
  100% { transform: translateY(360rpx) translateX(40rpx) rotate(540deg); opacity: 0; }
}

/* 夏 · 萤火虫 */
.summer .season-particle { width: 8rpx; height: 8rpx; background: #FFFFC8; border-radius: 50%; box-shadow: 0 0 16rpx #FFFE8A; }
.summer .season-particle.p1 { top: 30%; left: 12%; animation: fireflyTwinkle 3.2s ease-in-out infinite; }
.summer .season-particle.p2 { top: 50%; left: 38%; animation: fireflyTwinkle 4.0s ease-in-out infinite 1.0s; }
.summer .season-particle.p3 { top: 40%; left: 65%; animation: fireflyTwinkle 3.6s ease-in-out infinite 1.5s; }
.summer .season-particle.p4 { top: 62%; left: 80%; animation: fireflyTwinkle 4.4s ease-in-out infinite 0.5s; }
.summer .season-particle.p5 { top: 72%; left: 45%; animation: fireflyTwinkle 3.8s ease-in-out infinite 2.0s; }
@keyframes fireflyTwinkle {
  0%, 100% { opacity: .25; transform: scale(.8); }
  50%      { opacity: 1;   transform: scale(1.4); }
}

/* 秋 · 枫叶 */
.autumn .season-particle { width: 18rpx; height: 18rpx; background: #D2691E; border-radius: 0 100% 0 100%; }
.autumn .season-particle.p1 { top: -20rpx; left: 18%; animation: leafFall 10s linear infinite; }
.autumn .season-particle.p2 { top: -30rpx; left: 50%; animation: leafFall 13s linear infinite 2s; }
.autumn .season-particle.p3 { top: -25rpx; left: 80%; animation: leafFall 11s linear infinite 4s; }
.autumn .season-particle.p4 { top: -20rpx; left: 35%; animation: leafFall 12s linear infinite 1s; }
.autumn .season-particle.p5 { top: -30rpx; left: 62%; animation: leafFall 11.5s linear infinite 3s; }
@keyframes leafFall {
  0%   { transform: translateY(0) translateX(0) rotate(0deg); opacity: 0; }
  10%  { opacity: .9; }
  100% { transform: translateY(360rpx) translateX(120rpx) rotate(720deg); opacity: 0; }
}

/* 冬 · 雪花 */
.winter .season-particle { width: 10rpx; height: 10rpx; background: #fff; border-radius: 50%; box-shadow: 0 0 6rpx rgba(255,255,255,.5); }
.winter .season-particle.p1 { top: -20rpx; left: 12%; animation: snowFall 14s linear infinite; }
.winter .season-particle.p2 { top: -30rpx; left: 38%; animation: snowFall 16s linear infinite 2s; }
.winter .season-particle.p3 { top: -25rpx; left: 62%; animation: snowFall 15s linear infinite 4s; }
.winter .season-particle.p4 { top: -20rpx; left: 82%; animation: snowFall 18s linear infinite 1s; }
.winter .season-particle.p5 { top: -30rpx; left: 25%; animation: snowFall 13s linear infinite 3s; }
@keyframes snowFall {
  0%   { transform: translateY(0) translateX(0); opacity: 0; }
  10%  { opacity: .95; }
  100% { transform: translateY(360rpx) translateX(-40rpx); opacity: 0; }
}

/* 天空右下角季节+月相小标签 */
.sky-tag { position: absolute; top: 16rpx; right: 24rpx; z-index: 2; padding: 4rpx 14rpx; font-size: 20rpx; border-radius: 999rpx; background: rgba(255,255,255,.55); color: #5C4A3D; backdrop-filter: blur(8rpx); }
.sky-tag.spring { color: #C16A8A; }
.sky-tag.summer { color: #6A8F45; }
.sky-tag.autumn { color: #B35A1E; }
.sky-tag.winter { color: #486A8C; }

/* ═════════════════════════════════════════════════════════════
 * v5 阶梯花园（取代旧的纸花网格）
 * ═════════════════════════════════════════════════════════════ */
.staircase-garden { margin: 20rpx 32rpx 28rpx; padding: 28rpx 24rpx; background: linear-gradient(180deg, #FFF8E8 0%, #FAF1DC 100%); border-radius: 40rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.04); }
.staircase-garden .section-label { margin-bottom: 4rpx; }
.staircase-garden .sl-tag {
  margin-left: auto;
  font-size: 22rpx; padding: 4rpx 14rpx; font-weight: 600;
  background: #FAECE7; color: #993C1D;
  border-radius: 999rpx;
}

.sg-stage-stage { position: relative; width: 100%; height: 220rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 8rpx; }
.sg-stage-img { width: 220rpx; height: 220rpx; z-index: 1; animation: sgFloat 4s ease-in-out infinite; }
.sg-stage-shadow {
  position: absolute; bottom: 4rpx; left: 50%; transform: translateX(-50%);
  width: 220rpx; height: 24rpx; border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(0,0,0,.18) 0%, transparent 70%);
}
@keyframes sgFloat {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-8rpx); }
}

.sg-track { display: flex; align-items: flex-end; gap: 8rpx; padding: 0 12rpx; margin-bottom: 16rpx; }
.sg-step {
  flex: 1; background: rgba(255,255,255,.55); border: 2rpx solid #DDD3BD;
  border-radius: 14rpx 14rpx 6rpx 6rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  font-size: 18rpx; color: #A89F8A; gap: 4rpx; padding: 8rpx 0;
  transition: all .3s; position: relative;
}
.sg-step-num { font-size: 18rpx; font-weight: 600; }
.sg-step-name { font-size: 16rpx; line-height: 1.2; text-align: center; padding: 0 4rpx; }
.sg-step.achieved {
  background: linear-gradient(180deg, #FFE8D5 0%, #F8D3AC 100%);
  border-color: #D85A30; color: #993C1D;
}
.sg-step.current {
  background: linear-gradient(180deg, #F08458 0%, #C94416 100%);
  border-color: #712B13; color: #fff;
  transform: translateY(-12rpx);
  box-shadow: 0 6rpx 16rpx rgba(216,90,48,.35);
}
.sg-step.current .sg-step-num { font-size: 24rpx; }
.sg-step.current::before {
  content: ''; position: absolute; top: -16rpx; left: 50%; transform: translateX(-50%);
  width: 0; height: 0; border-left: 12rpx solid transparent; border-right: 12rpx solid transparent;
  border-bottom: 14rpx solid #C94416;
}

.sg-hint { text-align: center; font-size: 24rpx; color: var(--ink-soft); }
.sg-hint-num { color: #D85A30; font-weight: 700; font-size: 32rpx; padding: 0 6rpx; }
.sg-hint.done { color: #993C1D; font-weight: 600; }
