/* ═══ 花园 v6.0：对齐 UI 稿 ═══ */

.garden-page { min-height: 100vh; padding-bottom: 140rpx; background: #E8E2D6; }

/* ── 主景卡片 ── */
.garden-card {
  position: relative;
  height: 680rpx;
  overflow: hidden;
  background: #A8CDE8;
  box-shadow: 0 8rpx 28rpx rgba(91,70,54,.12);
}
.gc-bg {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
}
.gc-stage-wrap {
  /* 真机兼容：filter 挂外层 view（Web 组件）比直接挂原生 <image> 稳得多 */
  position: absolute;
  left: 50%; bottom: -20rpx;
  transform: translateX(-50%);
  width: 540rpx; height: 540rpx;
  z-index: 3;
  filter: drop-shadow(0 16rpx 28rpx rgba(91,70,54,.32));
}
.gc-stage-img {
  width: 100%; height: 100%;
  display: block;
  /* fill-mode both：动画开始前用 0% keyframe、结束后保持 100% keyframe，避免任何帧丢失导致图变透明 */
  animation: stage-pop .55s cubic-bezier(.34,1.56,.64,1) both;
}
@keyframes stage-pop {
  /* image 现在 width:100% 填满外层已居中的 wrap，自身不再做 translateX(-50%) */
  0%   { opacity: 0; transform: scale(.7);  }
  60%  { opacity: 1; transform: scale(1.06); }
  100% { opacity: 1; transform: scale(1);    }
}

/* 能量粒子 */
.energy-dot {
  position: absolute;
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #FFF7D0 0%, #F5A623 70%);
  box-shadow: 0 0 16rpx rgba(255,200,80,.9);
  animation: pulse 2s ease-in-out infinite;
  z-index: 5;
}
@keyframes pulse {
  0%, 100% { opacity: .6; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.4); }
}

/* 顶部浮层标题 */
.garden-hud {
  position: absolute;
  left: 32rpx; right: 32rpx; top: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 8;
}
.hud-title { display: flex; align-items: center; gap: 10rpx; }
.hud-icon { width: 36rpx; height: 36rpx; }
.hud-text { font-size: 32rpx; font-weight: 800; color: #4A2A17; text-shadow: 0 1rpx 0 rgba(255,255,255,.6); }
.hud-stats {
  display: flex; align-items: center; gap: 8rpx;
  padding: 8rpx 18rpx;
  background: rgba(255,255,255,.66);
  border-radius: 999rpx;
  font-size: 22rpx; color: #5C4A3D;
  backdrop-filter: blur(6rpx);
}
.hud-num { color: #C94416; font-weight: 800; font-size: 26rpx; margin: 0 2rpx; }
.hud-sep { color: rgba(0,0,0,.2); }

/* 右侧容器：数据 + 分享按钮 */
.hud-right { display: flex; align-items: center; gap: 12rpx; }

/* 分享按钮：圆形深色底，白色纸艺分享图标清晰可辨 */
.garden-share {
  width: 60rpx; height: 60rpx; padding: 0; margin: 0;
  border-radius: 50%;
  background: rgba(0,0,0,.28);
  border: 1rpx solid rgba(255,255,255,.35);
  display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(6rpx);
  line-height: 1;
  transition: transform .15s ease;
}
/* 重置小程序 button 默认 ::after 边框 */
.garden-share::after { border: none; }
.garden-share-tap { transform: scale(.9); }

/* ── 棕色区域 ── */
.garden-brown {
  background: linear-gradient(180deg, #4A2A17 0%, #2E1A0E 100%);
  border-radius: 56rpx 56rpx 0 0;
  /* margin-top -150：让棕色地块向上多提一截（植物图 540rpx，根须约占底部 100~140rpx，
     原 -44rpx 盖不住根须，根须露在棕地上方很突兀；提到 -150rpx 把根须完全埋进土里）*/
  margin-top: -150rpx;
  /* padding-top 同步 44→104rpx，避免 progress 被新上沿的圆角切到，留出呼吸空间 */
  padding: 48rpx 36rpx 48rpx;
  position: relative;
  box-shadow: inset 0 2rpx 0 rgba(255,200,120,.18);
  z-index: 3;
  overflow: hidden;
}

/* 分区标题 */
.section { padding: 8rpx 0 0; }
.sec-head { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.sec-head .light {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #FFD98E; box-shadow: 0 0 12rpx rgba(255,217,142,.7);
}
.sec-title { font-size: 28rpx; font-weight: 800; color: #F4EBDA; letter-spacing: 1rpx; }

/* 进度条 */
.gc-progress { padding: 4rpx 8rpx 28rpx; display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.gc-progress-bar {
  width: 76%; height: 20rpx; border-radius: 12rpx;
  background: rgba(0,0,0,.28);
  box-shadow: inset 0 2rpx 4rpx rgba(0,0,0,.45);
  overflow: hidden; position: relative;
}
.gc-progress-fill {
  height: 100%; border-radius: 12rpx;
  background: linear-gradient(90deg, #9BE37A, #4CAF3B 55%, #2E7D1F);
  box-shadow: 0 0 16rpx rgba(124,217,87,.6), inset 0 2rpx 0 rgba(255,255,255,.35);
  position: relative;
  transition: width .6s ease;
}
.gc-progress-label {
  font-size: 22rpx; font-weight: 800; color: #F4EBDA;
  letter-spacing: 1rpx; text-shadow: 0 2rpx 4rpx rgba(0,0,0,.5);
}
.gc-num { color: #FFD98E; font-weight: 800; margin: 0 4rpx; }

/* ── 3D 阶梯 ── */
.stairs-3d {
  position: relative;
  width: 540rpx; height: 236rpx;
  margin: 8rpx auto 8rpx;
  padding-top: 20rpx;
}
.s3d {
  position: absolute; bottom: 0;
  width: 74rpx;
  filter: drop-shadow(0 8rpx 12rpx rgba(0,0,0,.35));
}
.s3d .front {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, #FFE9A8 0%, #F5A623 55%, #C97E1A 100%);
  border-radius: 8rpx 8rpx 0 0;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-weight: 800; font-size: 28rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,.3);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,.55), inset 0 -4rpx 8rpx rgba(0,0,0,.12);
  overflow: hidden;
}
.s3d .front::before {
  content: ''; position: absolute; left: 16%; right: 16%; top: 6rpx; height: 6rpx;
  background: rgba(255,255,255,.7); border-radius: 4rpx;
}
.s3d .front::after {
  content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 14rpx;
  background: linear-gradient(180deg, rgba(122,63,10,.05), rgba(122,63,10,.5));
}
.s3d.on .front {
  background: linear-gradient(180deg, #FFD180 0%, #FF8A2A 55%, #C0550A 100%);
  box-shadow: 0 0 48rpx rgba(255,150,40,.9), inset 0 2rpx 0 rgba(255,255,255,.6);
}
/* 当前阶梯呼吸高光 */
.stairs-glow {
  position: absolute;
  width: 200rpx; height: 236rpx;
  transform: translate(-50%, 0);
  border-radius: 0;
  background: transparent;
  pointer-events: none;
  /* 大光晕贴在容器底部（当前激活阶梯顶上） */
  overflow: visible;
}
.stairs-glow::before {
  content: "";
  position: absolute;
  left: 50%; bottom: 16rpx;
  width: 180rpx; height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,220,140,.7) 0%, rgba(255,200,80,.32) 35%, transparent 70%);
  transform: translate(-50%, 0);
  animation: glow-breathe 2.4s ease-in-out infinite;
  pointer-events: none;
}
@keyframes glow-breathe {
  0%, 100% { opacity: .78; transform: translate(-50%, 0) scale(1); }
  50% { opacity: 1; transform: translate(-50%, 0) scale(1.18); }
}
/* 当前阶梯上飘升的金色粒子（UI 稿 .stairs-glow i + @keyframes p-rise）*/
.stairs-glow .particle {
  position: absolute;
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: radial-gradient(circle, #FFF7D0 0%, #FFD98E 45%, rgba(255,180,60,.4) 80%, transparent 100%);
  box-shadow: 0 0 16rpx rgba(255,200,80,.95), 0 0 4rpx #FFF6E2;
  opacity: 0;
  will-change: transform, opacity;
  transform: translate(0, 0) scale(.2);
  animation: p-rise 2.4s ease-out infinite;
}
@keyframes p-rise {
  0%   { transform: translate(0, 0) scale(.2);                          opacity: 0; }
  15%  { transform: translate(0, 0) scale(1.1);                          opacity: 1; }
  70%  { opacity: .6; }
  100% { transform: translate(var(--dx, 0), var(--dy, -200rpx)) scale(.35); opacity: 0; }
}

/* ── 成长徽章 ── */
.badge-wrap { padding: 20rpx 6rpx 10rpx; }

/* 顶部大勋章 */
.badge-hero {
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  background: radial-gradient(circle at 28% 22%, rgba(255,217,142,.18) 0%, transparent 32%),
              radial-gradient(circle at 78% 18%, rgba(255,180,60,.16) 0%, transparent 36%),
              radial-gradient(circle at 50% 65%, rgba(255,217,142,.14) 0%, transparent 42%),
              linear-gradient(135deg, #4A2A17 0%, #3A2010 55%, #2E1A0E 100%);
  border: 2rpx solid rgba(255,217,142,.28);
  box-shadow: inset 0 2rpx 0 rgba(255,217,142,.22), inset 0 -16rpx 36rpx rgba(0,0,0,.25), 0 12rpx 36rpx rgba(0,0,0,.3);
  border-radius: 28rpx;
  padding: 16rpx 28rpx 12rpx;
  position: relative; overflow: hidden;
}
.medal-stage {
  position: relative;
  width: 320rpx; height: 340rpx;
  display: flex; align-items: center; justify-content: center;
}
.medal-bg {
  position: absolute; left: 0; top: 0;
  width: 100%; height: 100%;
  filter: drop-shadow(0 12rpx 28rpx rgba(0,0,0,.45));
}
/* 中央叠加层：覆盖大勋章原「勋章」圆盘（Hough 检测金盘圆心 cy≈48.2%） */
.medal-center {
  position: absolute; left: 50%; top: 48.3%;
  transform: translate(-50%, -50%);
  width: 152rpx; height: 152rpx;
  border-radius: 50%;
  overflow: hidden; z-index: 3;
  box-shadow: 0 0 0 4rpx rgba(255,217,142,.55), 0 0 36rpx rgba(255,200,80,.6);
}
.medal-center-img { width: 100%; height: 100%; display: block; }
.badge-hero-info {
  position: relative; z-index: 2; text-align: center; margin-top: 6rpx;
  font-size: 26rpx; font-weight: 800; letter-spacing: 3rpx;
  color: #FFE6B8; text-shadow: 0 2rpx 0 rgba(0,0,0,.5), 0 0 20rpx rgba(255,180,60,.35);
}

/* 6 枚小徽章 */
.badge-grid {
  margin-top: 28rpx;
  display: flex; flex-wrap: wrap;
  gap: 28rpx 0;
  position: relative;
}
.badge-cell {
  width: 33.33%;
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  position: relative; z-index: 2;
}
.badge-cell .ring {
  width: 108rpx; height: 108rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  position: relative; overflow: hidden;
  box-shadow: 0 0 0 4rpx rgba(255,255,255,.12), 0 12rpx 28rpx rgba(0,0,0,.45);
}
.ring-img { width: 100%; height: 100%; display: block; }
.ring-lock { width: 72rpx; height: 72rpx; opacity: .9; }
.badge-cell .label {
  font-size: 22rpx; font-weight: 800; color: #F4E6CC;
  letter-spacing: 1rpx; text-shadow: 0 2rpx 0 rgba(0,0,0,.6);
}
/* 未解锁 */
.badge-cell.lock .ring {
  background: radial-gradient(circle at 35% 30%, #3A2716, #1F140A 75%);
  box-shadow: 0 0 0 4rpx rgba(255,255,255,.06), 0 8rpx 20rpx rgba(0,0,0,.6);
}
.badge-cell.lock .label { color: #8A7558; font-weight: 700; }
/* 已解锁（最新解锁带金色高光） */
.badge-cell.earned .ring {
  box-shadow: 0 0 0 4rpx rgba(255,217,142,.5), 0 0 36rpx rgba(255,180,60,.55), 0 8rpx 20rpx rgba(0,0,0,.45);
}
