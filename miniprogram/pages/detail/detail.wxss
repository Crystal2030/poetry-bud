.detail-page { position: relative; width: 100vw; height: 100vh; overflow: hidden; }
.d-bg { position: absolute; inset: 0; width: 100%; height: 100%; }
.d-veil-t { position: absolute; top: 0; left: 0; right: 0; height: 320rpx; z-index: 5; background: linear-gradient(rgba(0,0,0,0.35), transparent); }
.d-veil-b { position: absolute; bottom: 0; left: 0; right: 0; height: 520rpx; z-index: 5; background: linear-gradient(transparent, rgba(0,0,0,0.45)); }
.loading { display: flex; align-items: center; justify-content: center; height: 100%; color: #fff; font-size: 28rpx; }

.d-top { position: absolute; top: 80rpx; left: 0; right: 0; z-index: 40; display: flex; align-items: center; justify-content: space-between; padding: 8rpx 32rpx; }
.icon-btn { width: 68rpx; height: 68rpx; border-radius: 50%; background: rgba(255,255,255,0.22); display: flex; align-items: center; justify-content: center; border: 2rpx solid rgba(255,255,255,0.3); }

.d-poem-area { position: absolute; top: 152rpx; right: 48rpx; z-index: 30; max-width: 480rpx; }

.d-cta { position: absolute; right: 32rpx; bottom: 280rpx; z-index: 37; background: var(--seal); color: #fff; font-size: 24rpx; padding: 18rpx 30rpx; border-radius: 40rpx; display: flex; align-items: center; box-shadow: 0 6rpx 24rpx rgba(192,85,63,0.45); }

.read-bar { position: absolute; left: 32rpx; right: 32rpx; bottom: 300rpx; z-index: 35; background: rgba(20,28,40,0.42); border-radius: 40rpx; padding: 24rpx 28rpx; display: flex; align-items: center; gap: 24rpx; border: 2rpx solid rgba(255,255,255,0.14); }
.play-btn { width: 88rpx; height: 88rpx; border-radius: 50%; background: var(--gold); display: flex; align-items: center; justify-content: center; box-shadow: 0 6rpx 20rpx rgba(0,0,0,0.3); }
.read-info { flex: 1; }
.ri-title { color: #fff; font-size: 24rpx; opacity: 0.88; display: block; }
.wave-row { display: flex; align-items: flex-end; gap: 4rpx; height: 32rpx; margin-top: 10rpx; }
.wave-bar { width: 5rpx; background: var(--gold); border-radius: 4rpx; animation: wave 1.1s ease-in-out infinite; }
@keyframes wave { 0%,100% { height: 10rpx; } 50% { height: 32rpx; } }

/* ── 抽屉：三段式 + 过渡动画 ── */
.drawer {
  position: absolute; left: 0; right: 0; bottom: 0; z-index: 40;
  background: linear-gradient(rgba(245,235,218,0.92), rgba(245,235,218,0.99));
  padding: 24rpx 40rpx 0;
  display: flex; flex-direction: column;
  transition: height 0.32s cubic-bezier(0.4, 0, 0.2, 1),
              border-radius 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  border-radius: 44rpx 44rpx 0 0;
  overflow: hidden;
}

.grip { width: 80rpx; height: 10rpx; background: #C9BBA7; border-radius: 6rpx; margin: 0 auto 20rpx; flex-shrink: 0; }
.tags { display: flex; gap: 12rpx; margin-bottom: 10rpx; flex-wrap: wrap; flex-shrink: 0; }
.tag { font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 24rpx; background: var(--paper-warm); color: var(--ink-soft); }

/* ── Tab 栏 ── */
.tab-bar {
  display: flex; gap: 0; flex-shrink: 0;
  margin: 4rpx -8rpx 4rpx;
  border-bottom: 2rpx solid rgba(201,187,167,0.25);
}
.tab-item {
  flex: 1; text-align: center;
  font-size: 24rpx; color: #9B8E7E;
  padding: 14rpx 0 12rpx;
  position: relative;
  transition: color 0.2s;
  font-weight: 500;
}
.tab-item.active { color: #534AB7; font-weight: 700; }
.tab-item.active::after {
  content: '';
  position: absolute; bottom: -3rpx; left: 25%; right: 25%; height: 5rpx;
  background: #534AB7; border-radius: 3rpx 3rpx 0 0;
}

.d-title { font-size: 22rpx; color: var(--moss-deep); margin: 4rpx 0 8rpx; flex-shrink: 0; text-align: center; }
.d-title .hint { font-size: 22rpx; color: var(--moss-deep); font-weight: 400; }

/* ── 滚动内容区 ── */
.drawer-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  padding-bottom: 40rpx;
}

.drawer-section { margin-top: 16rpx; }
.ds-label { font-size: 24rpx; color: var(--ink); font-weight: 600; margin-bottom: 12rpx; padding-top: 8rpx; }
.ds-text { font-size: 24rpx; color: var(--ink-soft); line-height: 1.85; }
.ds-text-secondary { font-size: 22rpx; color: var(--ink-soft); opacity: 0.7; line-height: 1.7; margin-top: 10rpx; }

/* ── 逐句卡片 ── */
.sentence-card {
  background: rgba(255,255,255,0.65);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(201,187,167,0.35);
}

.sc-original {
  font-size: 30rpx;
  color: var(--ink);
  font-family: 'STKaiti', 'KaiTi', serif;
  letter-spacing: 4rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.sc-pinyin {
  font-size: 20rpx;
  color: var(--ink-soft);
  opacity: 0.6;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.sc-trans {
  font-size: 23rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  border-left: 4rpx solid var(--gold);
  padding: 4rpx 0 4rpx 16rpx;
  margin: 10rpx 0;
}

.sc-words { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.sw-item { display: flex; align-items: baseline; gap: 6rpx; background: rgba(201,187,167,0.25); border-radius: 10rpx; padding: 6rpx 14rpx; }
.sw-word { font-size: 20rpx; color: var(--seal); font-weight: 600; }
.sw-note { font-size: 20rpx; color: var(--ink-soft); }

/* ── 译文 Tab ── */
.trans-line-wrap {
  margin-bottom: 18rpx;
  padding: 16rpx 20rpx;
  background: rgba(255,255,255,0.55);
  border-radius: 16rpx;
  border: 1rpx solid rgba(201,187,167,0.2);
}
.tl-original {
  font-size: 26rpx;
  color: var(--ink);
  font-family: 'STKaiti', 'KaiTi', serif;
  font-weight: 600;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}
.tl-trans {
  font-size: 23rpx;
  color: var(--ink-soft);
  line-height: 1.75;
  padding-left: 10rpx;
  border-left: 3rpx solid rgba(83,74,183,0.35);
}
.trans-summary {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(83,74,183,0.06);
  border-radius: 14rpx;
  font-size: 23rpx;
  color: var(--ink-soft);
  line-height: 1.8;
  border: 1rpx solid rgba(83,74,183,0.12);
}

/* ── 赏析 Tab ── */
.appre-text {
  font-size: 25rpx;
  color: var(--ink-soft);
  line-height: 2;
}
.appre-text .appre-section { margin-bottom: 20rpx; }
.appre-text .as-title {
  font-size: 24rpx;
  color: #534AB7;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.appre-text .as-body {
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.85;
}
.appre-text .as-body-secondary {
  font-size: 22rpx;
  color: var(--ink-soft);
  opacity: 0.7;
  line-height: 1.7;
  margin-top: 8rpx;
}

/* ── 背景 Tab ── */
.bg-text {
  font-size: 25rpx;
  color: var(--ink-soft);
  line-height: 2;
}
.bg-info-card {
  background: rgba(255,255,255,0.55);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(201,187,167,0.25);
}
.bg-info-line {
  display: block;
  font-size: 23rpx;
  color: var(--ink-soft);
  margin-bottom: 8rpx;
}
.bg-info-line:last-child { margin-bottom: 0; }
.bg-note {
  display: block;
  font-size: 23rpx;
  color: var(--ink-soft);
  line-height: 1.8;
}

/* ── 作者 Tab ── */
.author-header {
  display: flex; gap: 18rpx; align-items: center;
  margin-bottom: 22rpx;
}
.author-avatar {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  background: linear-gradient(135deg, #534AB7, #8B80E0);
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 36rpx; font-weight: 700;
  flex-shrink: 0;
}
.author-name-block { flex: 1; }
.author-name {
  font-size: 30rpx; color: var(--ink); font-weight: 700; display: block;
}
.author-dynasty {
  font-size: 22rpx; color: #9B8E7E; margin-top: 4rpx; display: block;
}
.author-text {
  font-size: 25rpx;
  color: var(--ink-soft);
  line-height: 1.9;
}
.author-placeholder {
  padding: 16rpx 20rpx;
  background: rgba(255,255,255,0.5);
  border-radius: 14rpx;
  border: 1rpx solid rgba(201,187,167,0.2);
}
.ap-label {
  display: block;
  font-size: 22rpx;
  color: #534AB7;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.ap-body {
  font-size: 23rpx;
  color: var(--ink-soft);
  line-height: 1.8;
}
