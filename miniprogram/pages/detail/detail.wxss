.detail-page { position: relative; width: 100vw; height: 100vh; overflow: hidden; /* 封面图未加载时的暖色占位底，避免白屏 */ background: linear-gradient(165deg, #EDE5D3 0%, #E2D5BA 55%, #CDBFA0 100%); background-color: #E2D5BA; }
.d-bg { position: absolute; inset: 0; width: 100%; height: 100%; }
.d-veil-t { position: absolute; top: 0; left: 0; right: 0; height: 320rpx; z-index: 5; background: linear-gradient(rgba(0,0,0,0.35), transparent); }
.d-veil-b { position: absolute; bottom: 0; left: 0; right: 0; height: 520rpx; z-index: 5; background: linear-gradient(transparent, rgba(0,0,0,0.45)); }
.loading { display: flex; align-items: center; justify-content: center; height: 100%; color: #fff; font-size: 28rpx; }

/* ── 通用 icon 尺寸 ── */
.icon-sm { width: 36rpx; height: 36rpx; flex-shrink: 0; }

/* ── 返回按钮：独立浮动圆形 ── */
.back-btn {
  position: absolute; top: calc(env(safe-area-inset-top, 0) + 100rpx); left: 28rpx; z-index: 50;
  width: 72rpx; height: 72rpx; border-radius: 50%;
  background: rgba(0,0,0,0.32); border: 1rpx solid rgba(255,255,255,0.2);
  backdrop-filter: blur(12rpx);
  display: flex; align-items: center; justify-content: center;
  transition: opacity 0.4s ease, transform 0.15s ease;
}
.back-btn.dim { opacity: 0.18; }
.back-btn.dim:active { opacity: 0.9; }
.back-btn-tap { transform: scale(0.9); }

/* 返回箭头：使用 icon-svg component */

/* ── 诗句区域 ── */
.poem-area {
  position: absolute; top: calc(env(safe-area-inset-top, 0) + 200rpx); left: 28rpx; right: 28rpx; z-index: 30;
  display: flex; align-items: center; justify-content: center;
  max-height: calc(100vh - env(safe-area-inset-top, 0) - 600rpx);
  overflow: hidden;
  /* ── 古书卷轴衬底：半透明暖纸（以 background-color 确保兼容） ── */
  background-color: rgba(245,235,218,0.78);
  background-image: linear-gradient(180deg, rgba(247,240,228,0.78) 0%, rgba(242,234,216,0.84) 100%);
  border: 1rpx solid rgba(139,110,70,0.12);
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.20);
  padding: 20rpx 24rpx 24rpx;
}

/* ── 生成诗卡 FAB ── */
.d-cta {
  position: absolute; right: 28rpx; bottom: 280rpx; z-index: 42;
  background: var(--seal); color: #fff; font-size: 24rpx;
  padding: 16rpx 28rpx; border-radius: 40rpx;
  display: flex; align-items: center; gap: 10rpx;
  box-shadow: 0 6rpx 24rpx rgba(192,85,63,0.45);
  transition: transform 0.15s ease;
}
.d-cta-tap { transform: scale(0.94); }

/* 诗卡叠叠图标 */
.cta-card-icon { position: relative; width: 32rpx; height: 32rpx; }
.cci-a {
  position: absolute; top: 2rpx; left: 2rpx; width: 28rpx; height: 28rpx;
  background: rgba(255,255,255,0.9); border-radius: 4rpx;
  border: 2rpx solid rgba(255,255,255,0.4);
}
.cci-b {
  position: absolute; top: 0; left: 0; width: 28rpx; height: 28rpx;
  background: rgba(255,255,255,0.95); border-radius: 4rpx;
  transform: rotate(-8deg);
}

/* ── 收藏 FAB ── */
.fav-fab {
  position: absolute; right: 28rpx; bottom: 350rpx; z-index: 42;
  background: rgba(0,0,0,0.38); color: #fff; font-size: 24rpx;
  padding: 16rpx 28rpx; border-radius: 40rpx;
  display: flex; align-items: center; gap: 10rpx;
  backdrop-filter: blur(12rpx);
  border: 1rpx solid rgba(255,255,255,0.15);
  transition: all 0.2s ease;
}
.fav-fab.active {
  background: rgba(201,162,75,0.45);
  border-color: var(--gold);
}
.fav-fab-tap { transform: scale(0.94); }

.fav-fab.active .fav-star { background: var(--gold); }

/* 五角星：clip-path 多边形 */
.fav-star {
  width: 28rpx; height: 28rpx;
  background: #fff;
  clip-path: polygon(
    50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%,
    50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%
  );
  transition: background 0.2s ease;
}

.read-bar-wrap { position: absolute; left: 32rpx; right: 32rpx; z-index: 45; transition: bottom 0.32s cubic-bezier(0.4, 0, 0.2, 1); }
.read-bar { background: rgba(20,28,40,0.42); border-radius: 40rpx; padding: 24rpx 28rpx; display: flex; align-items: center; gap: 24rpx; border: 2rpx solid rgba(255,255,255,0.14); }
/* ── 扁平化播放按钮 ── */
.play-btn {
  width: 88rpx; height: 88rpx; border-radius: 50%;
  background: var(--gold);
  display: flex; align-items: center; justify-content: center;
  transition: transform 0.15s ease;
  flex-shrink: 0;
}
.play-btn-tap { transform: scale(0.92); }

/* 播放三角 */
.play-symbol {
  width: 0; height: 0;
  border-style: solid;
  border-width: 18rpx 0 18rpx 34rpx;
  border-color: transparent transparent transparent #fff;
  margin-left: 8rpx;
}

/* 暂停双竖线 */
.pause-symbol {
  display: flex; gap: 10rpx; align-items: center;
}
.pause-bar {
  width: 8rpx; height: 34rpx;
  background: #fff; border-radius: 3rpx;
}
.read-info { flex: 1; }
.ri-title { color: #fff; font-size: 24rpx; opacity: 0.88; display: flex; align-items: center; gap: 6rpx; }
.wave-row { display: flex; align-items: flex-end; gap: 4rpx; height: 32rpx; margin-top: 10rpx; }
.wave-bar { width: 5rpx; background: var(--gold); border-radius: 4rpx; animation: wave 1.1s ease-in-out infinite; }
@keyframes wave { 0%,100% { height: 10rpx; } 50% { height: 32rpx; } }

/* ── 语速倍速调节 ── */
.speed-btn {
  flex-shrink: 0;
  min-width: 84rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,0.14);
  border: 1rpx solid rgba(255,255,255,0.2);
  display: flex; align-items: center; justify-content: center;
  transition: all 0.2s ease;
}
.speed-btn.on { background: rgba(201,162,75,0.4); border-color: var(--gold); }
.speed-btn-tap { transform: scale(0.92); }
.speed-label { color: #fff; font-size: 22rpx; font-weight: 600; }

.speed-panel {
  display: flex; align-items: center; gap: 10rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 14rpx;
  background: rgba(20,28,40,0.55);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255,255,255,0.16);
}
.sp-option {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  border-radius: 20rpx;
  color: #fff;
  font-size: 22rpx;
  opacity: 0.75;
  transition: all 0.15s ease;
}
.sp-option.active {
  background: var(--gold);
  color: #fff;
  opacity: 1;
  font-weight: 700;
}

/* ── BGM 古琴开关按钮 ── */
.bgm-toggle {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  background: rgba(255,255,255,0.12);
  border: 1rpx solid rgba(255,255,255,0.18);
  transition: all 0.2s ease;
}
.bgm-toggle.on { background: rgba(201, 162, 75, 0.28); border-color: var(--gold); }
.bgm-toggle.off { opacity: 0.45; }
.bgm-toggle-tap { transform: scale(0.9); }
.bgm-icon { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.bgm-line { width: 22rpx; height: 2rpx; background: #fff; border-radius: 1rpx; }
.bgm-line.short { width: 14rpx; }

/* ── 音频进度条 ── */
.audio-progress {
  height: 6rpx; background: rgba(255,255,255,0.14); border-radius: 3rpx;
  overflow: hidden; margin-top: 8rpx;
}
.audio-progress-fill {
  height: 100%; background: var(--gold); border-radius: 3rpx;
  transition: width 0.15s linear;
}

/* ── 抽屉：三段式 + 过渡动画 ── */
.drawer {
  position: absolute; left: 0; right: 0; bottom: 0; z-index: 40;
  background: linear-gradient(rgba(245,235,218,0.92), rgba(245,235,218,0.99));
  padding: 24rpx 40rpx 0;
  display: flex; flex-direction: column;
  transition: height 0.32s cubic-bezier(0.4, 0, 0.2, 1),
              border-radius 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  border-radius: 44rpx 44rpx 0 0;
  overflow: hidden;
}

.grip { width: 80rpx; height: 10rpx; background: #C9BBA7; border-radius: 6rpx; margin: 0 auto 20rpx; flex-shrink: 0; }
.tags { display: flex; gap: 12rpx; margin-bottom: 10rpx; flex-wrap: wrap; flex-shrink: 0; }
.tag { font-size: 24rpx; padding: 6rpx 18rpx; border-radius: 24rpx; background: var(--paper-warm); color: var(--ink-soft); }

/* ── Tab 栏 ── */
.tab-bar {
  display: flex; gap: 0; flex-shrink: 0;
  margin: 4rpx -8rpx 4rpx;
  border-bottom: 2rpx solid rgba(201,187,167,0.25);
}
.tab-item {
  flex: 1; text-align: center;
  font-size: 26rpx; color: #9B8E7E;
  padding: 14rpx 0 12rpx;
  position: relative;
  transition: color 0.2s;
  font-weight: 500;
}
.tab-item.active { color: var(--purple); font-weight: 700; }
.tab-item.active::after {
  content: '';
  position: absolute; bottom: -3rpx; left: 25%; right: 25%; height: 5rpx;
  background: var(--purple); border-radius: 3rpx 3rpx 0 0;
}

.d-title { font-size: 22rpx; color: var(--moss-deep); margin: 4rpx 0 8rpx; flex-shrink: 0; text-align: center; }
.d-title .hint { font-size: 22rpx; color: var(--moss-deep); font-weight: 400; }

/* ── 滚动内容区 ── */
.drawer-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  padding-bottom: 40rpx;
}

.drawer-section { margin-top: 16rpx; }
.ds-label { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; color: var(--ink); font-weight: 600; margin-bottom: 12rpx; padding-top: 8rpx; }
.ds-text { font-size: 24rpx; color: var(--ink-soft); line-height: 1.85; }
.ds-text-secondary { font-size: 22rpx; color: var(--ink-soft); opacity: 0.7; line-height: 1.7; margin-top: 10rpx; }

/* ── 逐句卡片 ── */
.sentence-card {
  background: rgba(255,255,255,0.65);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(201,187,167,0.35);
}

.sc-original {
  font-size: 30rpx;
  color: var(--ink);
  font-family: "Kaiti SC", "STKaiti", "PingFang SC", serif;
  letter-spacing: 4rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.sc-pinyin {
  font-size: 20rpx;
  color: var(--ink-soft);
  opacity: 0.6;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.sc-trans {
  font-size: 23rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  border-left: 4rpx solid var(--gold);
  padding: 4rpx 0 4rpx 16rpx;
  margin: 10rpx 0;
}

.sc-words { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.sw-item { display: flex; align-items: baseline; gap: 6rpx; background: rgba(201,187,167,0.25); border-radius: 10rpx; padding: 6rpx 14rpx; }
.sw-word { font-size: 20rpx; color: var(--seal); font-weight: 600; }
.sw-note { font-size: 20rpx; color: var(--ink-soft); }

/* ── 译文 Tab ── */
.trans-para {
  font-size: 27rpx;
  color: var(--ink);
  line-height: 1.95;
  letter-spacing: 0.5rpx;
  text-indent: 2em;
  margin-bottom: 24rpx;
  padding: 6rpx 4rpx;
}
.trans-para:last-of-type { margin-bottom: 0; }
.trans-summary {
  display: flex; align-items: flex-start;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(83,74,183,0.06);
  border-radius: 14rpx;
  font-size: 23rpx;
  color: var(--ink-soft);
  line-height: 1.8;
  border: 1rpx solid rgba(83,74,183,0.12);
}

/* ── 赏析 Tab ── */
.appre-text {
  font-size: 25rpx;
  color: var(--ink-soft);
  line-height: 2;
}
.appre-text .appre-section { margin-bottom: 20rpx; }
.appre-text .as-title {
  display: flex; align-items: center; gap: 6rpx;
  font-size: 24rpx;
  color: var(--purple);
  font-weight: 600;
  margin-bottom: 8rpx;
}
.appre-text .as-body {
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.85;
}
.appre-text .as-body-secondary {
  font-size: 22rpx;
  color: var(--ink-soft);
  opacity: 0.7;
  line-height: 1.7;
  margin-top: 8rpx;
}

/* ── 背景 Tab ── */
.bg-text {
  font-size: 25rpx;
  color: var(--ink-soft);
  line-height: 2;
}
.bg-info-card {
  background: rgba(255,255,255,0.55);
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(201,187,167,0.25);
}
.bg-info-line {
  display: block;
  font-size: 23rpx;
  color: var(--ink-soft);
  margin-bottom: 8rpx;
}
.bg-info-line:last-child { margin-bottom: 0; }
.bg-note {
  display: block;
  font-size: 23rpx;
  color: var(--ink-soft);
  line-height: 1.8;
}

/* ── 作者 Tab ── */
.author-header {
  display: flex; gap: 18rpx; align-items: center;
  margin-bottom: 22rpx;
}
.author-avatar {
  width: 84rpx; height: 84rpx; border-radius: 50%;
  background: linear-gradient(135deg, var(--purple), var(--purple-light));
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 36rpx; font-weight: 700;
  flex-shrink: 0;
}
.author-name-block { flex: 1; }
.author-name {
  font-size: 30rpx; color: var(--ink); font-weight: 700; display: block;
}
.author-dynasty {
  font-size: 22rpx; color: #9B8E7E; margin-top: 4rpx; display: block;
}
.author-text {
  font-size: 25rpx;
  color: var(--ink-soft);
  line-height: 1.9;
}
.author-source {
  font-size: 20rpx;
  color: #b5a68a;
  text-align: right;
  margin-top: 8rpx;
  font-style: italic;
  opacity: 0.7;
}
.author-placeholder {
  padding: 16rpx 20rpx;
  background: rgba(255,255,255,0.5);
  border-radius: 14rpx;
  border: 1rpx solid rgba(201,187,167,0.2);
}
.ap-label {
  display: flex; align-items: center; gap: 6rpx;
  font-size: 22rpx;
  color: var(--purple);
  font-weight: 600;
  margin-bottom: 6rpx;
}
.ap-body {
  font-size: 23rpx;
  color: var(--ink-soft);
  line-height: 1.8;
}

/* 按钮内容布局 */
.ra-btn-content { display: flex; align-items: center; justify-content: center; gap: 8rpx; }

/* 完成卡片头部 */
.card-header-area { display: flex; align-items: center; gap: 8rpx; }

/* ── 卷轴端头：左右金色小圆轴 ── */
.poem-area::before,
.poem-area::after {
  content: '';
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  width: 12rpx;
  background: linear-gradient(180deg, #C9A24B, #B8953A);
  border-radius: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}
.poem-area::before { left: -6rpx; }
.poem-area::after  { right: -6rpx; }

/* ── 跟读按钮 ── */
.record-btn {
  width: 96rpx; height: 72rpx; border-radius: 36rpx;
  background: rgba(255,255,255,0.12);
  border: 1rpx solid rgba(255,255,255,0.18);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 2rpx; flex-shrink: 0;
  transition: all 0.2s ease;
}
.record-btn.active {
  background: var(--seal);
  border-color: var(--seal);
  color: #fff;
}
.record-btn-tap { transform: scale(0.92); }
.rec-icon-img { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.rec-label { font-size: 18rpx; opacity: 0.85; display: block; }

/* ── 录音指示动画 ── */
.record-indicator { display: flex; align-items: flex-end; gap: 4rpx; height: 32rpx; margin-top: 10rpx; }
.rec-wave {
  width: 5rpx; background: var(--seal); border-radius: 4rpx;
  animation: recWave 0.8s ease-in-out infinite;
}
@keyframes recWave { 0%,100% { height: 10rpx; } 50% { height: 32rpx; } }

/* ── 评分面板 ── */
.rec-score-panel {
  margin-top: 12rpx; background: rgba(255,255,255,0.9);
  border-radius: 20rpx; padding: 18rpx 24rpx;
  border: 1rpx solid rgba(201,162,75,0.3);
}
.score-title { font-size: 22rpx; font-weight: 700; color: var(--purple); display: block; text-align: center; margin-bottom: 10rpx; }
.score-stars { display: flex; justify-content: center; gap: 8rpx; margin-bottom: 10rpx; }
.score-star { width: 36rpx; height: 36rpx; opacity: 0.25; transition: opacity 0.3s ease; }
.score-star.lit { opacity: 1; animation: starPop 0.3s ease; }
@keyframes starPop { 0% { transform: scale(0.5); } 50% { transform: scale(1.3); } 100% { transform: scale(1); } }
.score-detail { display: flex; justify-content: space-around; }
.sd-item { font-size: 20rpx; color: var(--ink-soft); }

/* ── 趣味小测浮层 ── */
.quiz-overlay {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(0,0,0,0.55);
  display: flex; align-items: center; justify-content: center;
  animation: fadeIn 0.25s ease;
}
.quiz-card {
  width: 560rpx; background: #fff; border-radius: 28rpx;
  padding: 32rpx 28rpx 24rpx;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.25);
}
.quiz-header { text-align: center; margin-bottom: 16rpx; }
.quiz-title { display: flex; align-items: center; justify-content: center; gap: 6rpx; font-size: 26rpx; font-weight: 700; color: var(--purple); }
.quiz-question {
  font-size: 28rpx; color: var(--ink); font-weight: 600;
  text-align: center; margin: 20rpx 0 28rpx;
  line-height: 1.6;
}
.quiz-choices { display: flex; flex-direction: column; gap: 14rpx; }
.quiz-choice {
  display: flex; align-items: center; gap: 12rpx;
  padding: 18rpx 22rpx; border-radius: 16rpx;
  background: rgba(83,74,183,0.06);
  border: 2rpx solid transparent;
  font-size: 26rpx; color: var(--ink);
  transition: all 0.2s ease;
}
.quiz-choice:active { background: rgba(83,74,183,0.15); border-color: var(--purple); }
.qc-letter { color: var(--purple); font-weight: 700; font-size: 24rpx; width: 32rpx; }
.qc-text { flex: 1; }
.quiz-hint { text-align: center; font-size: 20rpx; color: var(--ink-soft); margin-top: 18rpx; opacity: 0.6; }

/* ── F-004 背诵Tab 通用 ── */
.recite-tab { color: var(--seal) !important; }
.recite-tab.active { color: var(--seal) !important; }
.recite-tab.active::after { background: var(--seal) !important; }

/* 背诵统计卡 */
.recite-stats-card {
  display: flex; align-items: center; gap: 20rpx;
  background: linear-gradient(135deg, rgba(192,85,63,0.08), rgba(201,162,75,0.12));
  border-radius: 20rpx; padding: 20rpx 24rpx;
  border: 1rpx solid rgba(201,162,75,0.2);
  margin-bottom: 16rpx;
}
.rs-badge-area { display: flex; flex-direction: column; align-items: center; min-width: 100rpx; }
.rs-badge-icon-img { width: 56rpx; height: 56rpx; flex-shrink: 0; }
.rs-badge-name { font-size: 22rpx; color: var(--seal); font-weight: 700; margin-top: 4rpx; }
.rs-count-area { display: flex; flex-direction: column; align-items: center; flex: 1; }
.rs-count-num { font-size: 44rpx; font-weight: 800; color: var(--purple); line-height: 1; }
.rs-count-label { font-size: 22rpx; color: var(--ink-soft); margin-top: 4rpx; }
.rs-next-area { flex: 1; text-align: right; }
.rs-next-hint { font-size: 20rpx; color: var(--ink-soft); opacity: 0.7; }

/* 三阶模式选择器 */
.recite-mode-bar {
  display: flex; gap: 12rpx; margin-bottom: 20rpx;
}
.rm-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 16rpx 4rpx; border-radius: 16rpx;
  background: rgba(255,255,255,0.5);
  border: 2rpx solid rgba(201,187,167,0.25);
  transition: all 0.2s ease;
}
.rm-item.active {
  background: rgba(192,85,63,0.1);
  border-color: var(--seal);
}
.rm-icon-img { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.rm-label { font-size: 24rpx; font-weight: 700; color: var(--ink); margin-top: 6rpx; }
.rm-desc { font-size: 18rpx; color: var(--ink-soft); opacity: 0.7; margin-top: 2rpx; }
.rm-item.active .rm-label { color: var(--seal); }
.rm-item.active .rm-desc { color: var(--seal); opacity: 0.8; }

/* 背诵引导 */
.recite-guide {
  background: rgba(83,74,183,0.06); border-radius: 14rpx;
  padding: 16rpx 20rpx; margin-bottom: 16rpx;
  border: 1rpx solid rgba(83,74,183,0.12);
}
.rg-title { font-size: 26rpx; font-weight: 700; color: var(--purple); display: flex; align-items: center; gap: 6rpx; margin-bottom: 6rpx; }
.rg-desc { font-size: 22rpx; color: var(--ink-soft); line-height: 1.6; display: block; }

/* 诗句展示区（背诵用） */
.recite-poem-display {
  background: rgba(255,255,255,0.6); border-radius: 18rpx;
  padding: 20rpx 22rpx; border: 1rpx solid rgba(201,187,167,0.25);
  margin-bottom: 20rpx;
}
.rp-line {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14rpx 16rpx; border-radius: 12rpx;
  margin-bottom: 8rpx; transition: background 0.2s ease;
}
.rp-line:last-child { margin-bottom: 0; }
.rp-line.active {
  background: rgba(192,85,63,0.12);
  border: 1rpx solid rgba(192,85,63,0.3);
}
.rp-text {
  font-size: 28rpx; color: var(--ink);
  font-family: "Kaiti SC", "STKaiti", "PingFang SC", serif;
  letter-spacing: 3rpx; font-weight: 600; flex: 1;
}
.rp-num {
  font-size: 20rpx; color: var(--ink-soft); opacity: 0.4;
  width: 40rpx; text-align: center; flex-shrink: 0;
}

/* 填空行 */
.fill-line { border: 1rpx solid transparent; }
.fill-line.revealed { background: rgba(139,195,74,0.08); border-color: rgba(139,195,74,0.3); }
.rp-fill-text { flex: 1; font-size: 28rpx; font-family: "Kaiti SC", "STKaiti", "PingFang SC", serif; letter-spacing: 3rpx; }
.fill-blank {
  display: inline-block; color: var(--seal); font-weight: 800;
  border-bottom: 2rpx dashed var(--seal); padding: 0 6rpx; margin: 0 4rpx;
  min-width: 40rpx; text-align: center; cursor: pointer;
  transition: all 0.2s ease;
}
.fill-blank.revealed {
  color: var(--purple); border-bottom-color: var(--purple);
  background: rgba(83,74,183,0.08); border-radius: 4rpx;
}

/* 操作按钮区 */
.recite-actions { text-align: center; margin-top: 12rpx; }
.ra-btn {
  display: inline-block; padding: 18rpx 48rpx; border-radius: 40rpx;
  font-size: 26rpx; font-weight: 700; border: none;
  transition: all 0.2s ease;
}
.ra-btn.primary {
  background: linear-gradient(135deg, var(--seal), #E07B5F);
  color: #fff; box-shadow: 0 6rpx 20rpx rgba(192,85,63,0.3);
}
.ra-btn.primary[disabled] {
  background: #ccc; box-shadow: none; opacity: 0.6;
}
.ra-btn.outline {
  background: rgba(255,255,255,0.7);
  color: var(--seal);
  border: 2rpx solid var(--seal);
}

/* 默背：隐藏诗句区 */
.full-recite-blank-area {
  background: rgba(255,255,255,0.5); border-radius: 18rpx;
  padding: 28rpx 22rpx; border: 1rpx dashed rgba(201,187,167,0.4);
  margin-bottom: 20rpx;
}
.fr-hidden-line {
  display: flex; align-items: center; gap: 14rpx;
  margin-bottom: 16rpx;
}
.fr-hidden-line:last-child { margin-bottom: 0; }
.fr-line-num {
  font-size: 22rpx; color: var(--ink-soft); opacity: 0.4;
  width: 36rpx; flex-shrink: 0;
}
.fr-blank-row {
  font-size: 26rpx; color: var(--ink-soft); opacity: 0.25;
  letter-spacing: 14rpx; flex: 1;
}

/* 默背自评 */
.recite-self-rate { text-align: center; margin-top: 16rpx; }
.rsr-title {
  font-size: 24rpx; color: var(--ink); font-weight: 600;
  display: block; margin-bottom: 14rpx;
}
.rsr-options {
  display: flex; gap: 12rpx; margin-bottom: 20rpx;
}
.rsr-opt {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 16rpx 8rpx; border-radius: 14rpx;
  background: rgba(255,255,255,0.5);
  border: 2rpx solid rgba(201,187,167,0.25);
  font-size: 20rpx; color: var(--ink-soft); gap: 6rpx;
  transition: all 0.2s ease;
}
.rsr-opt.chosen {
  background: rgba(201,162,75,0.12);
  border-color: var(--gold);
  color: var(--ink);
}
.rsr-icon-img { width: 40rpx; height: 40rpx; flex-shrink: 0; }

/* 徽章升级浮层 */
.badge-upgrade-overlay {
  position: fixed; inset: 0; z-index: 110;
  background: rgba(0,0,0,0.55);
  display: flex; align-items: center; justify-content: center;
  animation: fadeIn 0.3s ease;
}
.badge-upgrade-card {
  width: 500rpx; background: linear-gradient(180deg, #FFF8E7, #FFFFFF);
  border-radius: 32rpx; padding: 40rpx 32rpx 28rpx;
  text-align: center;
  box-shadow: 0 16rpx 56rpx rgba(0,0,0,0.3);
  animation: badgePop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
@keyframes badgePop {
  0% { transform: scale(0.5); opacity: 0; }
  60% { transform: scale(1.08); }
  100% { transform: scale(1); opacity: 1; }
}
.bu-icon-img { width: 80rpx; height: 80rpx; display: block; margin: 0 auto 10rpx; animation: badgeBounce 0.8s ease infinite; }
@keyframes badgeBounce {
  0%,100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}
.bu-title { font-size: 30rpx; font-weight: 800; color: var(--seal); display: block; margin-bottom: 8rpx; }
.bu-badge { font-size: 40rpx; font-weight: 800; color: var(--purple); display: block; margin-bottom: 8rpx; }
.bu-desc { font-size: 24rpx; color: var(--ink-soft); display: block; margin-bottom: 10rpx; }
.bu-from { font-size: 20rpx; color: var(--ink-soft); opacity: 0.6; margin-bottom: 20rpx; }
.bu-close {
  background: linear-gradient(135deg, var(--gold-bright), var(--gold-deep));
  color: #fff; font-size: 26rpx; font-weight: 700;
  padding: 16rpx 48rpx; border-radius: 36rpx;
  border: none; margin-top: 8rpx;
}

/* ══════════ 完成反馈三层 ══════════ */
.feedback-toast { position:fixed; top:120rpx; left:50%; transform:translateX(-50%) translateY(-120%); z-index:200; display:flex; align-items:center; gap:12rpx; background:var(--paper-warm); border-radius:var(--radius-xl); padding:16rpx 32rpx; font-size:26rpx; color:var(--ink); box-shadow:0 4px 12px var(--shadow-lg); border:1px solid var(--gold); transition:transform 0.3s var(--ease-bounce); }
.toast-show { transform:translateX(-50%) translateY(0); }
.toast-sprout-img { width: 40rpx; height: 40rpx; flex-shrink: 0; }
.toast-text { max-width:400rpx; }

.completion-overlay { position:fixed; inset:0; background:rgba(43,42,40,0.4); z-index:190; display:flex; align-items:flex-end; justify-content:center; opacity:0; pointer-events:none; transition:opacity 0.3s; }
.overlay-show { opacity:1; pointer-events:auto; }
.completion-card { width:100%; max-width:700rpx; padding:32rpx 28rpx 40rpx; border-radius:var(--radius-xl) var(--radius-xl) 0 0; background:var(--paper); border-top:3px solid var(--gold); animation:slideUp 0.4s var(--ease-spring); }
@keyframes slideUp { from{transform:translateY(100%);} to{transform:translateY(0);} }
.card-close { position:absolute; top:20rpx; right:28rpx; font-size:36rpx; color:var(--ink-soft); }
.card-congrats { font-size:30rpx; font-weight:700; color:var(--ink); }
.card-poem { text-align:center; margin:20rpx 0; }
.card-poem-title { font-size:40rpx; font-family:'STKaiti','KaiTi',serif; color:var(--ink); display:block; }
.card-poem-author { font-size:24rpx; color:var(--ink-soft); }
.results-title { font-size:26rpx; font-weight:600; color:var(--ink); margin-bottom:12rpx; display:flex; align-items:center; gap:6rpx; }
.result-row { display:flex; align-items:center; gap:12rpx; padding:14rpx; background:rgba(244,235,218,0.5); border-radius:var(--radius-sm); margin-bottom:8rpx; }
.result-label { font-size:24rpx; color:var(--ink-soft); }
.result-comment { flex:1; font-size:24rpx; color:var(--moss); font-weight:600; }
.result-stars { display:flex; align-items:center; gap:4rpx; font-size:20rpx; color:var(--gold); }
.card-actions { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-top:24rpx; }
.action-btn { padding:20rpx; border-radius:var(--radius-xl); font-size:26rpx; font-weight:600; }
.action-primary { background:linear-gradient(135deg,var(--gold),var(--gold-deep)); color:#fff; border:none; }
.action-secondary { background:none; border:1px solid var(--gold); color:var(--gold-deep); }

/* 全屏庆祝 */
.celebration-overlay { position:fixed; inset:0; z-index:210; background:rgba(244,235,218,0.95); display:flex; flex-direction:column; align-items:center; justify-content:center; opacity:0; pointer-events:none; transition:opacity 0.5s; }
.celebration-show { opacity:1; pointer-events:auto; }
.petal-container { position:absolute; inset:0; overflow:hidden; }
.petal { position:absolute; top:-20rpx; width:28rpx; height:28rpx; background:var(--lotus); border-radius:50% 0 50% 0; animation:petalFall 4s linear infinite; opacity:0; }
.petal:nth-child(2n) { background:var(--gold-bright); animation-duration:3.5s; }
.petal:nth-child(3n) { background:#FFC0C0; animation-duration:4.5s; }
@keyframes petalFall { 0%{transform:translateY(-40rpx) rotate(0deg);opacity:1;} 100%{transform:translateY(900rpx) rotate(720deg);opacity:0;} }
.celebration-content { position:relative; z-index:1; text-align:center; }
.sprout-cheer-img { width: 80rpx; height: 80rpx; animation: bounceIn 0.6s var(--ease-spring); }
@keyframes bounceIn { 0%{transform:scale(0);opacity:0;} 60%{transform:scale(1.2);} 100%{transform:scale(1);opacity:1;} }
.celebrate-badge-title { display:flex; align-items:center; justify-content:center; gap:8rpx; font-size:36rpx; font-weight:700; color:var(--seal); margin-top:20rpx; }
.celebrate-badge-name { display:block; font-size:32rpx; color:var(--ink); margin-top:8rpx; }
.celebrate-badge-desc { display:block; font-size:24rpx; color:var(--ink-soft); margin-top:4rpx; }
.celebrate-share-btn { margin-top:30rpx; padding:16rpx 40rpx; }
.gold-btn-sm { background:linear-gradient(135deg,var(--gold),var(--gold-deep)); color:#fff; border:none; border-radius:var(--radius-xl); padding:16rpx 32rpx; font-size:26rpx; font-weight:600; }
.skip-hint { display:block; font-size:20rpx; color:var(--ink-soft); margin-top:20rpx; }
