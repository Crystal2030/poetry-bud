/* ===== 竖排诗组件 · iOS 兼容版（每字一个 block 元素） ===== */

/* 整组：列从右到左 */
/* 字体优先级：先 Kaiti 系列（iOS/macOS 系统字体），再 Songti/SimSun/思源宋体（Android 衬线），最后落到 serif */
/* 去掉 "PingFang SC"/"Microsoft YaHei" 等无衬线兜底，避免 Android 上 fallback 到黑体观感 */
.vpoem {
  display: flex;
  flex-direction: row-reverse;
  align-items: flex-start;
  font-family: "STKaiti", "Kaiti SC", "Kaiti", "BiauKai", "KaiTi", "STKaiti-TC", "Songti SC", "STSong", "FangSong", "STFangsong", "SimSun", "Noto Serif SC", "Source Han Serif SC", "Noto Serif CJK SC", "Noto Serif", serif;
  color: #2C2A26;
  /* 优化：每字加宽字符间距，楷体观感更舒展 */
  letter-spacing: 0.05em;
}

/* 每列：内部从上下堆叠 */
.col-title,
.col-author,
.col-line {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 关键：每个字独立成行（不依赖 writing-mode） */
.char {
  display: block;
  /* 行高 1.4：竖排诗需要更多呼吸感，楷体字本身纵向比无衬线更舒展 */
  line-height: 1.4;
  text-align: center;
  white-space: nowrap;
}

/* 标题列 */
.col-title .char {
  font-weight: 600;
  margin-bottom: 0.12em;
}
.col-title { margin-left: 0.18em; }

/* 作者列 */
.col-author {
  opacity: 0.78;
  margin-left: 0.22em;
}
.col-author .char {
  font-size: 0.86em;
  margin-bottom: 0.08em;
}

/* 诗句列 */
.col-line { margin-left: 0.28em; }
.col-line .char { margin-bottom: 0.1em; }

/* 亮色模式：白字 + 暗影 */
.mode-light {
  color: #FFFEF9;
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.55);
}

/* 暗色模式：深字 + 暖纸色光晕（让米色卷轴上的字"压印"出来，对比度好） */
.mode-dark {
  color: #1F1B16;
  text-shadow:
    0 0 2rpx rgba(255, 248, 232, 0.9),
    1rpx 1rpx 0 rgba(255, 248, 232, 0.85),
    -1rpx -1rpx 0 rgba(255, 248, 232, 0.85),
    1rpx -1rpx 0 rgba(255, 248, 232, 0.85),
    -1rpx 1rpx 0 rgba(255, 248, 232, 0.85);
}

/* 整句高亮（当 highlightIdx 落在此句） */
.col-line.active {
  color: #C9A24B !important;
  text-shadow: 0 0 28rpx rgba(201, 162, 75, 0.9) !important;
}
