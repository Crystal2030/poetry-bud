      },
      {
        "pagePath": "pages/garden/garden",
        "text": "花园",
        "iconPath": "static/tab-chart.png",
        "selectedIconPath": "static/tab-chart-active.png"
      },
      {
        "pagePath": "pages/me/me",
        "text": "我的",
        "iconPath": "static/tab-user.png",
        "selectedIconPath": "static/tab-user-active.png"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^poem-(.*)": "@/components/PoemVertical.vue"
