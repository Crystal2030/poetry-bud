      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "诗库"
      }
    },
    {
      "path": "pages/detail/detail",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "诗意"
      }
