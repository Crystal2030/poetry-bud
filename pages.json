    {
      "path": "pages/card/card",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "诗卡"
      }
    },
    {
      "path": "pages/garden/garden",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "花园"
      }
